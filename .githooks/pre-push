#!/bin/sh
# The pre-push hook (`decisions/process.md`, C186, the committer on
# `main`). `main` takes no commit whose committer is Claude: a cloud
# session commits with the owner as author and Claude as committer, and
# such a commit is committed again here, keeping its author and message,
# before it reaches `main`. This hook refuses a push to `main` that
# carries one, names each, and prints how to commit them again. A push
# to any other branch is not read, so a cloud branch still reaches
# GitHub. A merge made on GitHub's site is no push and passes no hook;
# GitHub commits a squash or a rebase merge as itself. `--no-verify`
# skips this hook, as it skips every one.
#
# The commits read are those the push adds after the remote's tip when
# this clone has that tip, and otherwise every commit the pushed one
# reaches: a commit another remote branch already holds is still new to
# `main`. The way on names the refused branch and its base, so it runs
# from any checkout; a rebase would drop what a merge alone carries, so
# a push carrying a merge gets no rebase (main's ruleset takes linear
# history only). A shallow clone cannot read every commit it pushes, so
# a push to `main` from one is refused until it fetches the whole
# history. Each name in a printed command is quoted for the shell.
# Enable with: git config core.hooksPath .githooks

remote="$1"
zero_only() { case "$1" in *[!0]*) return 1 ;; esac; return 0; }
# q <word>: the word as a POSIX shell reads it back unchanged.
q() {
  case "$1" in
    *[!A-Za-z0-9_./:@+=,-]*|'') printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *) printf '%s' "$1" ;;
  esac
}
shallow=$(git rev-parse --is-shallow-repository 2>/dev/null)
bad=''
ways=''
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  zero_only "$local_sha" && continue  # a deletion carries no commit
  if [ "$shallow" = true ]; then
    {
      echo "pre-push: main takes no commit whose committer is Claude, and this clone is shallow: it cannot read every commit this push to main carries."
      echo "Fetch the whole history, then push again:"
      echo
      echo "  git fetch --unshallow $(q "$remote")"
    } >&2
    exit 1
  fi
  if ! zero_only "$remote_sha" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
    base=$(git rev-parse --short=12 "$remote_sha")
  else
    range="$local_sha"
    base=''
  fi
  # The test of a committer is `claude-committers`, beside this hook,
  # which CI's committer check reads too; a history git cannot read is
  # refused, never passed as clean.
  found=$("$(dirname "$0")/claude-committers" "$range")
  case $? in
    0) continue ;;
    1) ;;
    *)
      {
        echo "pre-push: main takes no commit whose committer is Claude, and git could not read every commit this push to main carries."
        echo "Repair the clone (git fsck names what is missing; git fetch $(q "$remote") may restore it), then push again."
      } >&2
      exit 1 ;;
  esac
  bad="$bad$found
"
  case "$local_ref" in
    refs/heads/*) branch=$(q "${local_ref#refs/heads/}"); again="git push $(q "$remote") $(q "${local_ref#refs/heads/}:main")" ;;
    *) branch=$(git rev-parse --short=12 "$local_sha"); again="git push $(q "$remote") HEAD:main" ;;
  esac
  if [ -n "$(git rev-list --min-parents=2 "$range")" ]; then
    ways="${ways}This push carries a merge, which main's ruleset refuses (linear history only), and a rebase would drop what the merge alone carries: make the change a line of commits first.
"
  elif [ -z "$base" ] && ! zero_only "$remote_sha"; then
    ways="${ways}This clone does not hold the remote's main: run git fetch $(q "$remote"), then push again to read the way on.
"
  elif [ -n "$base" ]; then
    ways="${ways}  git rebase --force-rebase $base $branch
  $again
"
  else
    ways="${ways}  git rebase --force-rebase --root $branch
  $again
"
  fi
done

[ -z "$bad" ] && exit 0
{
  echo "pre-push: main takes no commit whose committer is Claude, and this push to main carries:"
  printf '%s' "$bad"
  echo "Commit them again here, keeping each author and message (the committer becomes this clone's user), check each is signed (git log --format='%h %G? %cn'), and push:"
  printf '%s' "$ways"
} >&2
exit 1
