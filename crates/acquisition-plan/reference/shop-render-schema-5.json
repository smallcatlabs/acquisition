  "policy": [
    {
      "cell": "stash_item",
      "verdict": "post",
      "count": 4,
      "why": "a hand-priced stash item at a listed tab: `[linkItem realm= location=\"Stash<n>\" league= x= y=]` under the price's spoiler, `n` the tab's rank among the tabs the website lists — folders and substashes left out; a forum price takes precedence over the tab's in-game price"
    },
    {
      "cell": "character_item",
      "verdict": "post",
      "count": 1,
      "why": "a hand-priced character item in a slot: `[linkItem realm= location=\"<inventoryId>\" character= x= y=]` under the price's spoiler"
    },
    {
      "cell": "hand_no_price",
      "verdict": "post",
      "count": 1,
      "why": "a hand `no_price` item at an address a posting row takes: its link alone under an empty spoiler title, which the site lists as \"No Price Set\""
    },
    {
      "cell": "game_lists",
      "verdict": "omit",
      "count": 2,
      "why": "the game already lists it at its own price; a page must not contradict what the site shows"
    },
    {
      "cell": "game_skips",
      "verdict": "omit",
      "count": 1,
      "why": "the game marks it do-not-index (~skip) and the game decides; what the site makes of a forum price against a game skip is not observed"
    },
    {
      "cell": "hand_skip",
      "verdict": "omit",
      "count": 2,
      "why": "a hand skip means leave it out"
    },
    {
      "cell": "nothing_applies",
      "verdict": "off_page",
      "count": 2,
      "why": "no row applies and the game states nothing"
    },
    {
      "cell": "unresolved",
      "verdict": "block",
      "count": 1,
      "why": "a row that cannot be read could decide: never treated as unpriced; its price show reads it"
    },
    {
      "cell": "league_unknown",
      "verdict": "block",
      "count": 1,
      "why": "the listing gave its character no league, so the report is not evidence it belongs to this one"
    },
    {
      "cell": "unruled_kind",
      "verdict": "block",
      "count": 0,
      "why": "a hand price of a kind no row of this table writes (`exact` and `negotiable` are ruled; the rest are blocked)"
    },
    {
      "cell": "ratio",
      "verdict": "block",
      "count": 1,
      "why": "a ratio on the forum is unobserved; in game a typed ratio unlists the item"
    },
    {
      "cell": "retired_currency",
      "verdict": "block",
      "count": 1,
      "why": "the row cites a retired currency tag: the word the site reads for it is unknown"
    },
    {
      "cell": "realm_unlisted",
      "verdict": "block",
      "count": 0,
      "why": "the trade site's realms are pc, xbox and sony"
    },
    {
      "cell": "socketed",
      "verdict": "block",
      "count": 2,
      "why": "a socketed item has no position and cannot be linked"
    },
    {
      "cell": "no_position",
      "verdict": "block",
      "count": 0,
      "why": "the fetch gave the item no position, so no link can name it"
    },
    {
      "cell": "substash",
      "verdict": "block",
      "count": 1,
      "why": "the website's stash view offers no link for an item in a map or unique substash, and no other code for one has been observed: blocked until one is"
    },
    {
      "cell": "tab_unlisted",
      "verdict": "block",
      "count": 1,
      "why": "the tab is not on the current stash listing, so it has no index for `Stash<n>`"
    },
    {
      "cell": "invalid_index",
      "verdict": "block",
      "count": 0,
      "why": "the tab's recorded index is below zero: a corrupt fact, blocked rather than ranked"
    },
    {
      "cell": "no_slot",
