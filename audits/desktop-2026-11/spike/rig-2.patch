index 00000000..e22c68cb
--- /dev/null
+++ b/spikes/desktop-rig/src/main.rs
@@ -0,0 +1,329 @@
+//! The desktop spike's window (`roadmap/briefs/desktop-spike.md`): a
+//! loopback server over a clone of a store copy and one hand-written page,
+//! laid out like the C++ app, that logs each act of a sitting with its
+//! time split into the engine's, the transport's and the browser's share.
+//! Throwaway: never part of the product. Its record is
+//! `audits/desktop-2026-11/spike/README.md`.
+//!
+//! Every list the page shows is an answer the search gave: the tree's
+//! places are the search crate's places document (`Places::tabs`,
+//! `Places::characters`), a place's items its request's answer, the flat
+//! list one answer over the league, an item's card the answer to its id
+//! with the item asked. What the rig writes in Rust that the engine lacks
+//! is in `rules.rs`, listed for the design.
+//!
+//! Reads only: the account is opened through the verbs' door under the
+//! environment the start script sets, nothing is written but the log, no
+//! daemon is started, and the page loads nothing from off the machine (the
+//! content policy admits this server alone).
+
+mod rules;
+
+use std::io::Write as _;
+use std::net::SocketAddr;
+use std::sync::{Arc, Mutex, PoisonError};
+use std::time::Instant;
+
+use acquisition_search::answer::{Membership, QueryInput, Request, Rows, Scope, Shape, View};
+use acquisition_search::corpus::{Holder, Realm};
+use acquisition_verbs::frontend::{Frontend, Opened};
+use axum::Router;
+use axum::body::Bytes;
+use axum::extract::State;
+use axum::http::{HeaderMap, HeaderValue, StatusCode, header};
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use serde_json::{Value, json};
+
+const INDEX: &str = include_str!("../assets/index.html");
+const SCRIPT: &str = include_str!("../assets/app.js");
+const STYLE: &str = include_str!("../assets/app.css");
+const POLICY: &str = "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'";
+
+/// The engine: the account opened once, and the search crate's holder of
+/// the corpus, which checks currency before each answer (C98). One act is
+/// answered at a time; the wait for it is the queue the timing reports.
+struct Engine {
+    opened: Opened,
+    holder: Holder,
+    realm: Realm,
+    /// What the tree answered at the held corpus's basis (`rules::Held`).
+    held: Option<rules::Held>,
+    /// Each place's own terms at the held corpus's basis (`rules::Terms`).
+    terms: Option<rules::Terms>,
+}
+
+struct App {
+    engine: Mutex<Engine>,
+    log: Mutex<std::fs::File>,
+    host: String,
+}
+
+fn main() -> anyhow::Result<()> {
+    let mut args = std::env::args().skip(1);
+    let mut account = None;
+    let mut port: u16 = 0;
+    let mut log = None;
+    let mut check = None;
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--account" => account = args.next(),
+            "--port" => port = args.next().and_then(|p| p.parse().ok()).unwrap_or(0),
+            "--log" => log = args.next(),
+            "--check" => check = args.next(),
+            other => anyhow::bail!("unknown argument {other}"),
+        }
+    }
+    if let Some(league) = check {
+        let frontend = Frontend::human("desktop-rig").map_err(|f| anyhow::anyhow!("{f}"))?;
+        let account = frontend
+            .account(account.as_deref())
+            .map_err(|f| anyhow::anyhow!("{f}"))?;
+        let mut engine = Engine {
+            opened: open_read(&account)?,
+            holder: Holder::new(),
+            realm: Realm::parse("pc").map_err(|e| anyhow::anyhow!("{e}"))?,
+            held: None,
+            terms: None,
+        };
+        return rules::check(&mut engine, &league).map_err(|e| anyhow::anyhow!("{e}"));
+    }
+    let log =
+        log.ok_or_else(|| anyhow::anyhow!("--log <file> names where the sitting's acts go"))?;
+    let frontend = Frontend::human("desktop-rig").map_err(|f| anyhow::anyhow!("{f}"))?;
+    let account = frontend
+        .account(account.as_deref())
+        .map_err(|f| anyhow::anyhow!("{f}"))?;
+    let opened = open_read(&account)?;
+    let realm = Realm::parse("pc").map_err(|e| anyhow::anyhow!("{e}"))?;
+    let engine = Engine {
+        opened,
+        holder: Holder::new(),
+        realm,
+        held: None,
+        terms: None,
+    };
+    let mut file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(&log)?;
+    writeln!(
+        file,
+        "{}",
+        json!({"started": acquisition_store::now(), "pid": std::process::id(),
+               "store": std::env::var("ACQ_STORE_DIR").ok(), "account": account.entry.username})
+    )?;
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()?;
+    runtime.block_on(async move {
+        let listener =
+            tokio::net::TcpListener::bind(SocketAddr::from(([127, 0, 0, 1], port))).await?;
+        let bound = listener.local_addr()?;
+        let app = Arc::new(App {
+            engine: Mutex::new(engine),
+            log: Mutex::new(file),
+            host: bound.to_string(),
+        });
+        // load the corpus before the first act, as a running app would
+        // hold it: the first keystroke is not the corpus's load
+        {
+            let app = Arc::clone(&app);
+            tokio::task::spawn_blocking(move || warm(&app)).await??;
+        }
+        let router = Router::new()
+            .route(
+                "/",
+                get(
+                    |State(app): State<Arc<App>>, headers: HeaderMap| async move {
+                        asset(&app, &headers, INDEX, "text/html; charset=utf-8")
+                    },
+                ),
+            )
+            .route(
+                "/app.js",
+                get(
+                    |State(app): State<Arc<App>>, headers: HeaderMap| async move {
+                        asset(&app, &headers, SCRIPT, "text/javascript; charset=utf-8")
+                    },
+                ),
+            )
+            .route(
+                "/app.css",
+                get(
+                    |State(app): State<Arc<App>>, headers: HeaderMap| async move {
+                        asset(&app, &headers, STYLE, "text/css; charset=utf-8")
+                    },
+                ),
+            )
+            .route("/api/leagues", post(leagues))
+            .route("/api/view", post(view))
+            .route("/api/item", post(item))
+            .route("/api/log", post(log_acts))
+            .with_state(Arc::clone(&app));
+        println!("http://{bound}/");
+        axum::serve(listener, router).await?;
+        anyhow::Ok(())
+    })
+}
+
+/// The corpus and the largest league's places' terms, loaded before the
+/// first act, as a running app holds them: the first keystroke is not
+/// their load.
+fn warm(app: &App) -> anyhow::Result<()> {
+    let mut engine = app.engine.lock().unwrap_or_else(PoisonError::into_inner);
+    let leagues = rules::leagues(&engine).map_err(|e| anyhow::anyhow!("{e}"))?;
+    if let Some(league) = leagues["leagues"][0]["value"].as_str() {
+        rules::warm(&mut engine, league).map_err(|e| anyhow::anyhow!("{e}"))?;
+    }
+    Ok(())
+}
+
+/// The account's facts and its intent, each through the store's read-only
+/// door (never made nor migrated, nothing written): the rig writes nothing
+/// to the store. The verbs' door opens the intent for writing, so the
+/// intent is opened here by the account's uuid, as that door finds it.
+fn open_read(account: &acquisition_verbs::frontend::Account) -> anyhow::Result<Opened> {
+    let uuid = account.entry.uuid.as_deref().ok_or_else(|| {
+        anyhow::anyhow!("the account's entry names no uuid, so it has no intent file")
+    })?;
+    Ok(Opened {
+        account: account.clone(),
+        facts: account.facts_read().map_err(|e| anyhow::anyhow!("{e}"))?,
+        intent: acquisition_store::Annotations::open_read_only_for(&account.frontend.dir(), uuid)
+            .map_err(|e| anyhow::anyhow!("{e}"))?,
+    })
+}
+
+fn asset(app: &App, headers: &HeaderMap, body: &'static str, kind: &'static str) -> Response {
+    if let Err(refused) = guard(app, headers) {
+        return refused;
+    }
+    (
+        [
+            (header::CONTENT_TYPE, kind),
+            (header::CONTENT_SECURITY_POLICY, POLICY),
+            (header::CACHE_CONTROL, "no-store"),
+        ],
+        body,
+    )
+        .into_response()
+}
+
+/// A request whose Host is not this server's is refused: a page of
+/// another origin that rebinds a name to loopback reads nothing.
+fn guard(app: &App, headers: &HeaderMap) -> Result<(), Response> {
+    match headers.get(header::HOST).and_then(|h| h.to_str().ok()) {
+        Some(host) if host == app.host => Ok(()),
+        _ => Err((StatusCode::FORBIDDEN, "not this server's host").into_response()),
+    }
+}
+
+impl Engine {
+    fn request(&self, text: Option<String>, rows: Rows) -> Request {
+        Request {
+            scope: Scope {
+                account: None,
+                realm: Some(self.realm.clone()),
+                membership: Membership::Live,
+            },
+            query: QueryInput {
+                text,
+                tree: None,
+                trade: None,
+            },
+            view: View::from(Shape::Rows(rows)),
+            ..Request::default()
+        }
+    }
+}
+
+/// One act's answer, timed: the wait for the engine, and the engine's
+/// own time to the serialized body, which the `Server-Timing` header
+/// carries because the body cannot carry its own serialization.
+async fn answered(
+    app: Arc<App>,
+    headers: HeaderMap,
+    body: Bytes,
+    work: fn(&mut Engine, Value) -> Result<Value, String>,
+) -> Response {
+    if let Err(refused) = guard(&app, &headers) {
+        return refused;
+    }
+    let arrived = Instant::now();
+    let done = tokio::task::spawn_blocking(move || {
+        let asked: Value = serde_json::from_slice(&body).unwrap_or(Value::Null);
+        let mut engine = app.engine.lock().unwrap_or_else(PoisonError::into_inner);
+        let locked = Instant::now();
+        let mut out = match work(&mut engine, asked.clone()) {
+            Ok(v) => v,
+            Err(e) => json!({"error": e}),
+        };
+        out["seq"] = asked["seq"].clone();
+        let text = serde_json::to_string(&out).unwrap_or_default();
+        drop(engine);
+        let finished = Instant::now();
+        (text, locked - arrived, finished - locked)
+    })
+    .await;
+    match done {
+        Ok((text, queue, engine)) => {
+            let timing = format!(
+                "queue;dur={:.3}, engine;dur={:.3}",
+                queue.as_secs_f64() * 1e3,
+                engine.as_secs_f64() * 1e3
+            );
+            let mut response = ([(header::CONTENT_TYPE, "application/json")], text).into_response();
+            if let Ok(v) = HeaderValue::from_str(&timing) {
+                response.headers_mut().insert("server-timing", v);
+            }
+            response
+        }
+        Err(e) => (StatusCode::INTERNAL_SERVER_ERROR, e.to_string()).into_response(),
+    }
+}
+
+async fn leagues(State(app): State<Arc<App>>, headers: HeaderMap, body: Bytes) -> Response {
+    answered(app, headers, body, |engine, _| rules::leagues(engine)).await
+}
+
+async fn view(State(app): State<Arc<App>>, headers: HeaderMap, body: Bytes) -> Response {
+    answered(app, headers, body, |engine, asked| {
+        let asked: rules::Asked = serde_json::from_value(asked).map_err(|e| e.to_string())?;
+        rules::view(engine, &asked)
+    })
+    .await
+}
+
+async fn item(State(app): State<Arc<App>>, headers: HeaderMap, body: Bytes) -> Response {
+    answered(app, headers, body, |engine, asked| {
+        let id = asked["id"].as_str().unwrap_or("").to_string();
+        rules::card(engine, &id)
+    })
+    .await
+}
+
+/// The page's acts, appended to the sitting's log as they come.
+async fn log_acts(State(app): State<Arc<App>>, headers: HeaderMap, body: Bytes) -> Response {
+    if let Err(refused) = guard(&app, &headers) {
+        return refused;
+    }
+    let acts: Vec<Value> = match serde_json::from_slice(&body) {
+        Ok(acts) => acts,
+        Err(e) => return (StatusCode::BAD_REQUEST, e.to_string()).into_response(),
+    };
+    let mut file = app.log.lock().unwrap_or_else(PoisonError::into_inner);
+    let written = acts
+        .iter()
+        .try_for_each(|act| writeln!(file, "{act}"))
+        .and_then(|()| file.flush());
+    if let Err(e) = written {
+        eprintln!("the sitting's log was not written: {e}");
+        return (
+            StatusCode::INTERNAL_SERVER_ERROR,
+            format!("the log was not written: {e}"),
+        )
+            .into_response();
+    }
+    StatusCode::NO_CONTENT.into_response()
+}
diff --git a/spikes/desktop-rig/src/rules.rs b/spikes/desktop-rig/src/rules.rs
new file mode 100644
index 00000000..e13c16c3
--- /dev/null
+++ b/spikes/desktop-rig/src/rules.rs
@@ -0,0 +1,830 @@
+//! What the window asks of the engine, and the rules the rig had to write
+//! in Rust because the engine has none for them. Each such rule is marked
+//! **Rule** below; the record lists them for the design.
+//!
+//! - **Rule (fold):** the C++ app's form fields become one query in the
+//!   search's language. The engine folds `acq web`'s own form, not this one.
+//! - **Rule (open):** which places of the tree stand open — folders open
+//!   unless collapsed; tabs closed, but under a query the tabs with a match
+//!   open; the person's opens kept apart for with and without a query (the
+//!   C++ app's behaviour, claim B4 of the record). The places document says
+//!   what each place holds and matches; it has no rule for what is open.
+//! - **Rule (flatten):** the open tree as one list of rows, heads and items
+//!   in order, and a window of it by row number. The places document is a
+//!   tree; a scrolled list needs rows by index.
+//! - **Rule (card):** an item's card is the answer to its id with the item
+//!   asked, drawn from the shown item's own rows.
+
+use std::collections::{HashMap, HashSet};
+use std::time::Instant;
+
+use acquisition_search::answer::{Counts, Request, RowField, Rows, Shape, View};
+use acquisition_search::places::{Asking, Filter, Kind, Place, Places, Reading};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+use crate::Engine;
+
+/// The values each item row carries, by the search's own texts: the
+/// columns of the tree after the name.
+pub const VALUES: [&str; 10] = [
+    "price.amount",
+    "quality",
+    "stack",
+    "level",
+    "ilvl",
+    "links",
+    "sockets",
+    "reqlevel",
+    "pseudo.total_life",
+    "pseudo.total_ele_res",
+];
+
+/// The leagues of the realm with their items, by the answer's count of
+/// `league`: each bucket's term is the league's term as the search writes it.
+pub fn leagues(engine: &Engine) -> Result<Value, String> {
+    let mut request = engine.request(None, Rows::default());
+    request.view = View::from(Shape::Counts(Counts {
+        keys: vec!["league".to_string()],
+        sum: None,
+        limit: Some(100),
+    }));
+    let corpus = engine
+        .holder
+        .corpus(&request, &engine.opened.facts, &engine.opened.intent)
+        .map_err(|e| e.to_string())?;
+    let answer = acquisition_search::answer(&corpus, &request).map_err(|e| e.to_string())?;
+    let view = serde_json::to_value(&answer.view).map_err(|e| e.to_string())?;
+    let buckets = view["counts"]["tables"][0]["buckets"].clone();
+    Ok(json!({"leagues": buckets, "matched": answer.total.matched}))
+}
+
+/// What the page asks for a view: the form, the league, the mode, what
+/// the person opened and closed, the order, and a window of rows.
+#[derive(Debug, Default, Deserialize)]
+#[serde(default)]
+pub struct Asked {
+    pub league: String,
+    /// `tab` or `item`.
+    pub mode: String,
+    pub form: Form,
+    /// Folders the person collapsed.
+    pub collapsed: Vec<String>,
+    /// Places the person opened with no query.
+    pub open: Vec<String>,
+    /// Under a query: places the person opened, and closed.
+    pub fopen: Vec<String>,
+    pub fclosed: Vec<String>,
+    pub sort: Option<String>,
+    pub desc: bool,
+    pub offset: usize,
+    pub count: usize,
+}
+
+/// The form as the page sends it, every field its text.
+#[derive(Debug, Default, Deserialize)]
+#[serde(default)]
+pub struct Form {
+    pub tab: String,
+    pub name: String,
+    pub rarity: String,
+    pub query: String,
+    pub min: std::collections::BTreeMap<String, String>,
+    pub max: std::collections::BTreeMap<String, String>,
+    pub flags: Vec<String>,
+}
+
+/// The fields a range may name, each the search's field.
+const RANGES: [&str; 10] = [
+    "quality",
+    "level",
+    "ilvl",
+    "reqlevel",
+    "links",
+    "sockets",
+    "map_tier",
+    "pseudo.total_life",
+    "pseudo.total_ele_res",
+    "stack",
+];
+
+/// **Rule (fold).** The form as one query, and the fields that do not
+/// filter because their text is no number (the C++ app draws them red).
+pub fn fold(form: &Form) -> (Option<String>, serde_json::Map<String, Value>) {
+    let mut terms = Vec::new();
+    let mut bad = serde_json::Map::new();
+    let quoted = |s: &str| format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\""));
+    let tab = form.tab.trim();
+    if !tab.is_empty() {
+        terms.push(format!("(tab:{0} or character:{0})", quoted(tab)));
+    }
+    let name = form.name.trim();
+    if !name.is_empty() {
+        terms.push(format!("(name:{0} or typeline:{0})", quoted(name)));
+    }
+    match form.rarity.as_str() {
+        "" | "any" => {}
+        "nonunique" => terms.push("-rarity:\"unique\"".to_string()),
+        r => terms.push(format!("rarity:{}", quoted(r))),
+    }
+    for (bound, op, side) in [(&form.min, ">=", "min"), (&form.max, "<=", "max")] {
+        for (field, text) in bound {
+            let text = text.trim();
+            if text.is_empty() || !RANGES.contains(&field.as_str()) {
+                continue;
+            }
+            match number(text) {
+                Some(n) => terms.push(format!("{field}{op}{n}")),
+                None => {
+                    bad.insert(
+                        format!("{side}.{field}"),
+                        json!("a single number: 5, -3, 2.5 or 2,5"),
+                    );
+                }
+            }
+        }
+    }
+    for flag in &form.flags {
+        match flag.as_str() {
+            "corrupted" => terms.push("is:corrupted".to_string()),
+            "priced" => terms.push("has:priced".to_string()),
+            "fractured" => terms.push("is:fractured".to_string()),
+            _ => {}
+        }
+    }
+    let query = form.query.trim();
+    if !query.is_empty() {
+        terms.push(format!("({query})"));
+    }
+    ((!terms.is_empty()).then(|| terms.join(" ")), bad)
+}
+
+/// A number as the C++ app's form reads one: a point or a comma as the
+/// decimal separator; a comma before exactly three digits is refused.
+fn number(text: &str) -> Option<String> {
+    if let Some((a, b)) = text.split_once(',') {
+        if b.len() == 3 && b.chars().all(|c| c.is_ascii_digit()) && !a.is_empty() {
+            return None;
+        }
+    }
+    let n: f64 = text.replace(',', ".").parse().ok()?;
+    n.is_finite().then(|| {
+        if n.fract() == 0.0 {
+            format!("{}", n as i64)
+        } else {
+            format!("{n}")
+        }
+    })
+}
+
+/// The rows view every place's request and the flat list take.
+fn rows_view(asked: &Asked) -> Rows {
+    Rows {
+        sort: asked.sort.clone(),
+        desc: asked.desc,
+        values: VALUES.iter().map(|v| v.to_string()).collect(),
+        ..Rows::default()
+    }
+}
+
+/// One stretch of the flattened tree.
+enum Seg<'a> {
+    Head {
+        place: &'a Place,
+        depth: usize,
+        open: bool,
+        count: usize,
+    },
+    /// A place's own items.
+    Items {
+        id: &'a str,
+        request: &'a Request,
+        depth: usize,
+        count: usize,
+    },
+}
+
+impl Seg<'_> {
+    fn rows(&self) -> usize {
+        match self {
+            Seg::Head { .. } => 1,
+            Seg::Items { count, .. } => *count,
+        }
+    }
+}
+
+/// **Rule (hold).** What the tree answered at one basis for one league,
+/// query and order: the two places documents, and each place's rows once
+/// a window has asked for them. Reused only while the held corpus's basis
+/// is the one it was answered at, which the holder checks before every
+/// act (C98); an expansion or a scroll then asks the engine nothing new.
+pub struct Held {
+    basis: acquisition_search::corpus::Basis,
+    key: (String, Option<String>, Option<String>, bool),
+    tabs: Places,
+    characters: Places,
+    rows: HashMap<String, Vec<Value>>,
+}
+
+struct Opens<'a> {
+    queried: bool,
+    collapsed: HashSet<&'a str>,
+    open: HashSet<&'a str>,
+    fopen: HashSet<&'a str>,
+    fclosed: HashSet<&'a str>,
+}
+
+impl Opens<'_> {
+    /// **Rule (open).**
+    fn is_open(&self, place: &Place) -> bool {
+        let id = place.id();
+        match place.place {
+            Kind::Folder => !self.collapsed.contains(id),
+            _ if self.queried => {
+                (place.matched.unwrap_or(0) > 0 && !self.fclosed.contains(id))
+                    || self.fopen.contains(id)
+            }
+            _ => self.open.contains(id),
+        }
+    }
+}
+
+/// **Rule (flatten).** The places, each listed one a head, an open one
+/// followed by the places it holds and then its own items.
+fn flatten<'a>(places: &'a [Place], depth: usize, opens: &Opens, out: &mut Vec<Seg<'a>>) {
+    for place in places {
+        if !place.is_listed() {
+            continue;
+        }
+        // what the head counts: under a query its matches; else its items,
+        // a folder's the places it holds
+        let count = if opens.queried {
+            place.matched.unwrap_or(0)
+        } else if place.place == Kind::Folder {
+            place.holds.map_or(0, |h| h.places)
+        } else {
+            usize::try_from(place.item_count()).unwrap_or(0)
+        };
+        let open = opens.is_open(place);
+        out.push(Seg::Head {
+            place,
+            depth,
+            open,
+            count,
+        });
+        if !open {
+            continue;
+        }
+        flatten(&place.places, depth + 1, opens, out);
+        // the items in the place itself: under a query a tab with pages
+        // says its own apart
+        let own = if place.place == Kind::Folder {
+            0
+        } else if opens.queried {
+            if place.places.is_empty() {
+                place.matched.unwrap_or(0)
+            } else {
+                place.own.unwrap_or(0)
+            }
+        } else {
+            usize::try_from(place.item_count()).unwrap_or(0)
+        };
+        if let Some(request) = place.request.as_ref().filter(|_| own > 0) {
+            out.push(Seg::Items {
+                id: place.id(),
+                request,
+                depth: depth + 1,
+                count: own,
+            });
+        }
+    }
+}
+
+fn ms(since: Instant) -> f64 {
+    since.elapsed().as_secs_f64() * 1e3
+}
+
+/// The view: the tree or the flat list, its rows counted, and the window
+/// asked of them.
+pub fn view(engine: &mut Engine, asked: &Asked) -> Result<Value, String> {
+    let mut parts = serde_json::Map::new();
+    let (text, bad) = fold(&asked.form);
+    let view = rows_view(asked);
+    let started = Instant::now();
+    let base = engine.request(text.clone(), view.clone());
+    let corpus = engine
+        .holder
+        .corpus(&base, &engine.opened.facts, &engine.opened.intent)
+        .map_err(|e| e.to_string())?;
+    parts.insert("corpus".into(), json!(ms(started)));
+    let mut out = if asked.mode == "item" {
+        flat(engine, &corpus, asked, text, view, &mut parts)?
+    } else {
+        tree(engine, &corpus, asked, text, view, &mut parts)?
+    };
+    out["bad"] = Value::Object(bad);
+    out["basis"] = json!(corpus.basis);
+    out["parts"] = Value::Object(parts);
+    Ok(out)
+}
+
+/// An item row as the page draws it, without its index.
+fn item_row(row: &acquisition_search::answer::Row) -> Value {
+    json!({
+        "k": "i", "id": row.id,
+        "name": row.name.clone().or_else(|| row.typeline.clone()),
+        "type": row.name.as_ref().and(row.typeline.clone()),
+        "rarity": row.rarity,
+        "v": row.values.iter().map(|v| v.value.clone().unwrap_or(Value::Null)).collect::<Vec<_>>(),
+    })
+}
+
+/// The flat list: one head, then the window of the query's matches over
+/// the league, one answer, its total the list's length.
+fn flat(
+    engine: &Engine,
+    corpus: &acquisition_search::Corpus,
+    asked: &Asked,
+    text: Option<String>,
+    view: Rows,
+    parts: &mut serde_json::Map<String, Value>,
+) -> Result<Value, String> {
+    let started = Instant::now();
+    // the league's term as the answer's count of `league` writes it
+    let league = format!("league=\"{}\"", asked.league.replace('"', "\\\""));
+    let both = match &text {
+        Some(t) => format!("{league} ({t})"),
+        None => league,
+    };
+    let first = asked.offset.saturating_sub(1);
+    let mut request = engine.request(Some(both), view.clone());
+    request.basis = Some(corpus.basis.clone());
+    if let Shape::Rows(r) = &mut request.view.shape {
+        r.after = Some(first);
+        r.limit = Some(asked.count.max(1));
+    }
+    let answer = acquisition_search::answer(corpus, &request).map_err(|e| e.to_string())?;
+    parts.insert("answer".into(), json!(ms(started)));
+    let matched = answer.total.matched;
+    let mut rows = Vec::new();
+    if asked.offset == 0 {
+        rows.push(
+            json!({"k": "h", "i": 0, "d": 0, "id": "", "name": "All Items", "kind": "all",
+                         "n": matched, "open": true, "holds": false, "never": false}),
+        );
+    }
+    for (k, row) in answer.rows.iter().enumerate() {
+        let mut r = item_row(row);
+        r["i"] = json!(first + 1 + k);
+        r["d"] = json!(1);
+        rows.push(r);
+    }
+    Ok(
+        json!({"query": answer.query.text, "caption": matched, "total_rows": matched + 1,
+              "offset": asked.offset, "rows": rows}),
+    )
+}
+
+/// The tree: the league's places, held at the basis (Rule (hold)),
+/// flattened by what is open, and the window's rows, each place's rows
+/// answered once by its own request.
+fn tree(
+    engine: &mut Engine,
+    corpus: &acquisition_search::Corpus,
+    asked: &Asked,
+    text: Option<String>,
+    view: Rows,
+    parts: &mut serde_json::Map<String, Value>,
+) -> Result<Value, String> {
+    let key = (
+        asked.league.clone(),
+        text.clone(),
+        asked.sort.clone(),
+        asked.desc,
+    );
+    let fresh = !matches!(&engine.held, Some(h) if h.basis == corpus.basis && h.key == key);
+    if fresh {
+        let now = acquisition_store::now();
+        let reading = Reading {
+            store: &engine.opened.facts,
+            intent: &engine.opened.intent,
+            holder: &engine.holder,
+        };
+        let asking = Asking {
+            filter: Filter::default(),
+            query: text.clone(),
+            view: view.clone(),
+        };
+        let started = Instant::now();
+        let tabs =
+            Places::tabs(reading, "pc", &asked.league, &asking, now).map_err(|e| e.to_string())?;
+        parts.insert("tabs".into(), json!(ms(started)));
+        let started = Instant::now();
+        let characters = Places::characters(reading, "pc", &asked.league, &asking, now)
+            .map_err(|e| e.to_string())?;
+        parts.insert("characters".into(), json!(ms(started)));
+        engine.held = Some(Held {
+            basis: corpus.basis.clone(),
+            key,
+            tabs,
+            characters,
+            rows: HashMap::new(),
+        });
+    }
+    parts.insert("held".into(), json!(!fresh));
+    let Engine {
+        opened,
+        holder,
+        held,
+        terms: engine_terms,
+        ..
+    } = engine;
+    let Some(Held {
+        tabs,
+        characters,
+        rows: answered,
+        ..
+    }) = held.as_mut()
+    else {
+        return Err("nothing held".to_string());
+    };
+    let queried = text.is_some();
+    let opens = Opens {
+        queried,
+        collapsed: asked.collapsed.iter().map(String::as_str).collect(),
+        open: asked.open.iter().map(String::as_str).collect(),
+        fopen: asked.fopen.iter().map(String::as_str).collect(),
+        fclosed: asked.fclosed.iter().map(String::as_str).collect(),
+    };
+    let started = Instant::now();
+    let mut segs = Vec::new();
+    flatten(&tabs.places, 0, &opens, &mut segs);
+    flatten(&characters.places, 0, &opens, &mut segs);
+    parts.insert("flatten".into(), json!(ms(started)));
+    let caption = match (&tabs.query, &characters.query) {
+        (Some(a), Some(b)) => a.matched + b.matched,
+        _ => {
+            let sum = |p: &Places| -> usize {
+                p.every()
+                    .iter()
+                    .filter(|p| p.place != Kind::Folder)
+                    .map(|p| usize::try_from(p.item_count()).unwrap_or(0))
+                    .sum()
+            };
+            sum(tabs) + sum(characters)
+        }
+    };
+    let total_rows: usize = segs.iter().map(Seg::rows).sum();
+    let started = Instant::now();
+    let (from, to) = (
+        asked.offset.min(total_rows),
+        (asked.offset + asked.count).min(total_rows),
+    );
+    // **Rule (batch).** The places in the window not answered yet, answered
+    // as one request: each place's own terms (its request in the places
+    // document asked with no query) joined by `or`, before the query, one
+    // evaluation over the corpus, the rows then parted by the place each
+    // lies in. The query's terms come first in a place's own request, so
+    // answering places one by one evaluated the whole query once a place.
+    let mut wanted: Vec<(&str, &Request, usize)> = Vec::new();
+    {
+        let mut at = 0;
+        for seg in &segs {
+            let n = seg.rows();
+            if at.max(from) < (at + n).min(to)
+                && let Seg::Items {
+                    id, request, count, ..
+                } = seg
+                && !answered.contains_key(*id)
+            {
+                wanted.push((id, request, *count));
+            }
+            at += n;
+            if at >= to {
+                break;
+            }
+        }
+    }
+    let mut answers = 0;
+    if !wanted.is_empty() {
+        answers += 1;
+        let started = Instant::now();
+        let terms = plain_terms(
+            engine_terms,
+            reading_of(opened, holder),
+            corpus,
+            &asked.league,
+        )?;
+        parts.insert("terms".into(), json!(ms(started)));
+        let mut request = wanted[0].1.clone();
+        let places = wanted
+            .iter()
+            .map(|(id, _, _)| {
+                terms
+                    .get(*id)
+                    .map(|t| format!("({t})"))
+                    .ok_or(format!("no terms held for {id}"))
+            })
+            .collect::<Result<Vec<_>, _>>()?
+            .join(" or ");
+        request.query.text = Some(match &text {
+            Some(q) => format!("({places}) ({q})"),
+            None => places,
+        });
+        request.basis = Some(corpus.basis.clone());
+        if let Shape::Rows(r) = &mut request.view.shape {
+            r.limit = Some(wanted.iter().map(|w| w.2).sum::<usize>().max(1));
+        }
+        let answer = acquisition_search::answer(corpus, &request).map_err(|e| e.to_string())?;
+        let mut parted: HashMap<&str, Vec<Value>> =
+            wanted.iter().map(|(id, _, _)| (*id, Vec::new())).collect();
+        for row in &answer.rows {
+            if let Some(rows) = parted.get_mut(row.place.id.as_str()) {
+                rows.push(item_row(row));
+            }
+        }
+        for (id, rows) in parted {
+            answered.insert(id.to_string(), rows);
+        }
+    }
+    let mut rows = Vec::new();
+    let mut at = 0;
+    for seg in &segs {
+        let n = seg.rows();
+        let (a, b) = (at.max(from), (at + n).min(to));
+        if a < b {
+            match seg {
+                Seg::Head {
+                    place,
+                    depth,
+                    open,
+                    count,
+                } => rows.push(json!({
+                    "k": "h", "i": at, "d": depth, "id": place.id(), "name": place.name(),
+                    "kind": place.place, "n": count, "open": open,
+                    "holds": !place.places.is_empty() || place.request.is_some(),
+                    "never": place.never_fetched(),
+                })),
+                Seg::Items { id, depth, .. } => {
+                    let own = &answered[*id];
+                    for k in (a - at)..(b - at) {
+                        let mut r = own.get(k).cloned().unwrap_or(Value::Null);
+                        if r.is_null() {
+                            continue;
+                        }
+                        r["i"] = json!(at + k);
+                        r["d"] = json!(depth);
+                        rows.push(r);
+                    }
+                }
+            }
+        }
+        at += n;
+        if at >= to {
+            break;
+        }
+    }
+    parts.insert("window".into(), json!(ms(started)));
+    parts.insert("answers".into(), json!(answers));
+    let canonical = tabs.query.as_ref().map(|q| q.text.clone());
+    Ok(
+        json!({"query": canonical, "caption": caption, "total_rows": total_rows,
+              "offset": from, "rows": rows}),
+    )
+}
+
+/// **Rule (card).** The item as the answer to its id gives it, with the
+/// item asked: its header, its properties, its level, what it requires,
+/// its lines by their array, and where it lies.
+pub fn card(engine: &Engine, id: &str) -> Result<Value, String> {
+    let started = Instant::now();
+    let mut request = engine.request(
+        Some(format!("id:\"{}\"", id.replace('"', ""))),
+        Rows {
+            limit: Some(1),
+            fields: vec![RowField::Item],
+            ..Rows::default()
+        },
+    );
+    request.view.routes = false;
+    let corpus = engine
+        .holder
+        .corpus(&request, &engine.opened.facts, &engine.opened.intent)
+        .map_err(|e| e.to_string())?;
+    let answer = acquisition_search::answer(&corpus, &request).map_err(|e| e.to_string())?;
+    let answered = ms(started);
+    let row = answer
+        .rows
+        .into_iter()
+        .find(|r| r.id == id)
+        .ok_or_else(|| format!("no item {id} in the corpus"))?;
+    let shown = row.shown.ok_or("the answer carried no item")?;
+    let item = &shown.item;
+    let mut groups: Vec<(String, Vec<String>)> = Vec::new();
+    for line in &shown.lines {
+        let source = line.line.source.clone();
+        match groups.last_mut() {
+            Some((s, lines)) if *s == source => lines.push(line.line.text.clone()),
+            _ => groups.push((source, vec![line.line.text.clone()])),
+        }
+    }
+    let place = &row.place;
+    Ok(json!({
+        "id": row.id,
+        "name": item.name, "typeline": item.typeline, "rarity": item.rarity, "frame": item.frame,
+        "props": item.properties.iter().map(|p| p.text.clone()).collect::<Vec<_>>(),
+        "ilvl": item.item_level, "requires": item.requires,
+        "groups": groups.iter().map(|(s, l)| json!({"source": s, "lines": l})).collect::<Vec<_>>(),
+        "flags": item.flags, "note": item.note, "descr": item.descr,
+        "price": shown.price,
+        "place": {"league": place.league, "kind": place.kind, "name": place.name,
+                   "parent": place.parent.as_ref().and_then(|p| p.name.clone()),
+                   "cell": place.cell, "container": place.container},
+        "basis": corpus.basis,
+        "parts": {"answer": answered},
+    }))
+}
+
+/// The rig's own check, `--check <league>`: with every place open, under
+/// no query and under three, the rows the window draws are as many as the
+/// rows it counts, each at its index (no slot left waiting); and the flat
+/// list's rows are the answer's. Prints one line per case.
+pub fn check(engine: &mut Engine, league: &str) -> Result<(), String> {
+    for (query, sort) in [
+        ("", None),
+        ("rarity=unique", None),
+        ("pseudo.total_life>=70", Some("ilvl")),
+        ("(name:\"tabula\" or typeline:\"tabula\")", None),
+    ] {
+        let mut asked = Asked {
+            league: league.to_string(),
+            mode: "tab".to_string(),
+            form: Form {
+                query: query.to_string(),
+                ..Form::default()
+            },
+            sort: sort.map(str::to_string),
+            desc: true,
+            count: usize::MAX / 4,
+            ..Asked::default()
+        };
+        // first ask: the places; then every place open
+        let first = view(engine, &asked)?;
+        let held = engine.held.as_ref().ok_or("nothing held")?;
+        let ids: Vec<String> = held
+            .tabs
+            .every()
+            .iter()
+            .chain(held.characters.every().iter())
+            .map(|p| p.id().to_string())
+            .collect();
+        asked.open = ids.clone();
+        asked.fopen = ids;
+        let started = Instant::now();
+        let all = view(engine, &asked)?;
+        let rows = all["rows"].as_array().ok_or("no rows")?;
+        let total = all["total_rows"].as_u64().unwrap_or(0) as usize;
+        let at_index = rows
+            .iter()
+            .enumerate()
+            .all(|(k, r)| r["i"].as_u64() == Some(k as u64));
+        let items = rows.iter().filter(|r| r["k"] == "i").count();
+        println!(
+            "tab  {query:?}: caption {} · {} rows counted, {} drawn, {} items, each at its index: {} ({} ms, {} answers)",
+            first["caption"],
+            total,
+            rows.len(),
+            items,
+            at_index,
+            ms(started).round(),
+            all["parts"]["answers"]
+        );
+        if rows.len() != total || !at_index {
+            return Err(format!("{query:?}: rows drawn are not the rows counted"));
+        }
+        // the rows parted from one request are each place's own answer, in
+        // its order: compared for every place holding items
+        let held = engine.held.as_ref().ok_or("nothing held")?;
+        let corpus = engine
+            .holder
+            .corpus(
+                &engine.request(None, Rows::default()),
+                &engine.opened.facts,
+                &engine.opened.intent,
+            )
+            .map_err(|e| e.to_string())?;
+        let mut compared = 0;
+        for place in held
+            .tabs
+            .every()
+            .iter()
+            .chain(held.characters.every().iter())
+        {
+            let (Some(request), Some(parted)) = (place.request.as_ref(), held.rows.get(place.id()))
+            else {
+                continue;
+            };
+            if compared >= 200 {
+                break;
+            }
+            let mut request = request.clone();
+            if let Shape::Rows(r) = &mut request.view.shape {
+                r.limit = Some(100_000);
+            }
+            let alone = acquisition_search::answer(&corpus, &request).map_err(|e| e.to_string())?;
+            let ids: Vec<&str> = alone
+                .rows
+                .iter()
+                .filter(|r| r.place.id == place.id())
+                .map(|r| r.id.as_str())
+                .collect();
+            let held_ids: Vec<&str> = parted.iter().filter_map(|r| r["id"].as_str()).collect();
+            if ids != held_ids {
+                return Err(format!(
+                    "{query:?}: {}'s rows differ from its own answer",
+                    place.id()
+                ));
+            }
+            compared += 1;
+        }
+        println!("     {compared} places' rows are their own answers, in order");
+        asked.mode = "item".to_string();
+        asked.count = 300;
+        asked.offset = 0;
+        let flat = view(engine, &asked)?;
+        println!(
+            "item {query:?}: {} rows counted, {} drawn in the first window",
+            flat["total_rows"],
+            flat["rows"].as_array().map_or(0, Vec::len)
+        );
+    }
+    Ok(())
+}
+
+fn reading_of<'a>(
+    opened: &'a acquisition_verbs::frontend::Opened,
+    holder: &'a acquisition_search::corpus::Holder,
+) -> Reading<'a> {
+    Reading {
+        store: &opened.facts,
+        intent: &opened.intent,
+        holder,
+    }
+}
+
+/// Each place's own terms, by id: its request's text in the league's
+/// places documents asked with no query, held at the basis (Rule (hold)).
+pub struct Terms {
+    basis: acquisition_search::corpus::Basis,
+    league: String,
+    texts: HashMap<String, String>,
+}
+
+/// The default league's terms, read before the first act.
+pub fn warm(engine: &mut Engine, league: &str) -> Result<(), String> {
+    let corpus = engine
+        .holder
+        .corpus(
+            &engine.request(None, Rows::default()),
+            &engine.opened.facts,
+            &engine.opened.intent,
+        )
+        .map_err(|e| e.to_string())?;
+    let Engine {
+        opened,
+        holder,
+        terms,
+        ..
+    } = engine;
+    plain_terms(terms, reading_of(opened, holder), &corpus, league).map(|_| ())
+}
+
+fn plain_terms<'a>(
+    held: &'a mut Option<Terms>,
+    reading: Reading,
+    corpus: &acquisition_search::Corpus,
+    league: &str,
+) -> Result<&'a HashMap<String, String>, String> {
+    if !matches!(held, Some(t) if t.basis == corpus.basis && t.league == league) {
+        let now = acquisition_store::now();
+        let asking = Asking::default();
+        let tabs = Places::tabs(reading, "pc", league, &asking, now).map_err(|e| e.to_string())?;
+        let characters =
+            Places::characters(reading, "pc", league, &asking, now).map_err(|e| e.to_string())?;
+        let texts = tabs
+            .every()
+            .iter()
+            .chain(characters.every().iter())
+            .filter_map(|p| {
+                let text = p.request.as_ref()?.query.text.clone()?;
+                Some((p.id().to_string(), text))
+            })
+            .collect();
+        *held = Some(Terms {
+            basis: corpus.basis.clone(),
+            league: league.to_string(),
+            texts,
+        });
+    }
+    Ok(&held.as_ref().ok_or("no terms")?.texts)
+}
