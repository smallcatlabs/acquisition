@@ -0,0 +1,64 @@
+:root {
+  --bg: #1e1f22; --pane: #26272b; --line: #3a3b40; --text: #d8d8d8; --dim: #8a8b90;
+  --sel: #2f4f7f; --head: #2b2c31; --bad: #e05050;
+  --normal: #d0d0d0; --magic: #8f8fff; --rare: #ffff77; --unique: #c87a3a; --gem: #1ba29b; --currency: #b9ab88;
+  --row: 22px;
+}
+* { box-sizing: border-box; }
+html, body { margin: 0; height: 100%; }
+body { background: var(--bg); color: var(--text); font: 13px -apple-system, "Segoe UI", system-ui, sans-serif;
+  display: flex; flex-direction: column; overflow: hidden; user-select: none; }
+#top { display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid var(--line); padding: 4px 6px 0; }
+.stab { display: inline-block; padding: 4px 12px; border: 1px solid var(--line); border-bottom: none; border-radius: 4px 4px 0 0; background: var(--pane); }
+.league { padding-bottom: 4px; color: var(--dim); }
+select, input, textarea, button { background: #18191b; color: var(--text); border: 1px solid var(--line); border-radius: 3px; font: inherit; }
+input, select { height: 22px; padding: 0 4px; }
+#body { flex: 1; display: grid; grid-template-columns: minmax(150px, 2fr) 5fr 340px; min-height: 0; }
+#form { overflow-y: auto; overflow-x: hidden; padding: 6px; border-right: 1px solid var(--line); }
+#form .row { display: grid; grid-template-columns: 52px 1fr; gap: 4px; margin-bottom: 4px; align-items: center; }
+#form .row input, #form .row select { width: 100%; }
+fieldset { border: 1px solid var(--line); border-radius: 4px; margin: 6px 0; padding: 4px 6px; }
+legend { color: var(--dim); padding: 0 4px; }
+.range { display: grid; grid-template-columns: 1fr 48px 48px; gap: 4px; margin: 3px 0; align-items: center; }
+.range input { width: 100%; }
+.flag { display: block; margin: 2px 0; }
+textarea { width: 100%; resize: vertical; padding: 4px; font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
+.bad { border-color: var(--bad) !important; color: var(--bad); }
+#queryerror { color: var(--bad); white-space: pre-wrap; font-size: 12px; }
+#center { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+#cols, .r { display: grid; grid-template-columns: minmax(160px, 1fr) 62px 34px 46px 34px 34px 40px 40px 42px 44px 40px; }
+#cols { background: var(--head); border-bottom: 1px solid var(--line); height: var(--row); line-height: var(--row); }
+#cols span { padding: 0 4px; border-right: 1px solid var(--line); cursor: default; overflow: hidden; white-space: nowrap; }
+#cols span.num { text-align: right; }
+#cols span.sorted::after { content: " ▾"; }
+#cols span.sorted.asc::after { content: " ▴"; }
+#list { flex: 1; overflow-y: auto; overflow-x: hidden; position: relative; outline: none; contain: strict; }
+#spacer { width: 1px; }
+.r { position: absolute; left: 0; right: 0; height: var(--row); line-height: var(--row); white-space: nowrap; }
+.r span { overflow: hidden; text-overflow: ellipsis; padding: 0 4px; }
+.r span.num { text-align: right; color: #c0c0c0; }
+.r.h { background: #232428; color: #e6e6e6; }
+.r.h .name { font-weight: 600; grid-column: 1 / -1; display: flex; align-items: center; gap: 2px; height: var(--row); }
+.r.h .n { color: var(--dim); font-weight: 400; margin-left: 6px; }
+.r.never .name { color: var(--dim); font-style: italic; }
+.r.sel { background: var(--sel); }
+.r.wait { color: transparent; }
+.tw { flex: none; width: 14px; color: var(--dim); font-weight: 400; }
+.r .base { color: var(--dim); }
+.Normal { color: var(--normal); } .Magic { color: var(--magic); } .Rare { color: var(--rare); } .Unique { color: var(--unique); }
+#viewbar { border-top: 1px solid var(--line); padding: 3px 6px; color: var(--dim); }
+#panel { border-left: 1px solid var(--line); overflow-y: auto; padding: 8px; user-select: text; }
+#cardname { font-size: 15px; font-weight: 600; margin-bottom: 6px; min-height: 20px; }
+#cardtabs { display: flex; gap: 2px; margin-bottom: 6px; }
+#cardtabs button { padding: 2px 10px; }
+#cardtabs button.on { background: var(--sel); }
+#card { background: #0c0c0d; border: 1px solid #4a3a20; text-align: center; padding: 0 0 6px; }
+#card .hdr { padding: 6px; background: #1a140c; border-bottom: 1px solid #4a3a20; }
+#card .hdr div { font-size: 15px; }
+#card .sec { border-top: 1px solid #4a3a20; padding: 4px 8px; margin-top: 4px; }
+#card .sec:first-of-type { border-top: none; }
+#card .prop { color: #7f7f7f; } #card .mod { color: #8888ff; } #card .crafted { color: #b4b4ff; } #card .enchant { color: #b4b4ff; }
+#card .implicit { color: #8888ff; } #card .fractured { color: #a29162; } #card .flag { color: var(--bad); } #card .note { color: #aa9e82; }
+#cardtext { white-space: pre-wrap; font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
+#location { margin-top: 8px; color: var(--dim); }
+#status { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding: 3px 8px; color: var(--dim); font-size: 12px; }
diff --git a/spikes/desktop-rig/assets/app.js b/spikes/desktop-rig/assets/app.js
new file mode 100644
index 00000000..64c3acdb
--- /dev/null
+++ b/spikes/desktop-rig/assets/app.js
@@ -0,0 +1,393 @@
+// The desktop spike's window. Presentation only: every row it draws is a
+// row the server answered, at the server's index; it sorts, filters,
+// groups and composes nothing. It times each act from its input to the
+// paint that shows what the act asked for, and splits that time into the
+// browser's, the transport's and the engine's shares, which sum to it.
+"use strict";
+
+const ROW = 22;
+const COLS = [["Name", null], ["Price", "price.amount"], ["Q", "quality"], ["Stack", "stack"],
+  ["Lvl", "level"], ["ilvl", "ilvl"], ["Links", "links"], ["Sock", "sockets"],
+  ["R.Lvl", "reqlevel"], ["Life", "pseudo.total_life"], ["Res", "pseudo.total_ele_res"]];
+
+const $ = (s) => document.querySelector(s);
+const list = $("#list"), spacer = $("#spacer"), form = $("#form");
+const field = (n) => form.elements.namedItem(n);
+
+// What the page asks: the server rebuilds everything from it.
+const S = { league: "", mode: "tab", collapsed: new Set(), open: new Set(),
+  fopen: new Set(), fclosed: new Set(), sort: null, desc: false, queried: false };
+// The last window answered: its basis, its rows by index, the tree's size.
+let held = { basis: null, total: 0, rows: new Map(), key: "" };
+let selected = null;
+const drawn = new Map(); // index -> element
+
+// ---- acts ---------------------------------------------------------------
+let actSeq = 0;
+const log = [];          // finished acts, not yet sent to the server
+window.rigActs = [];     // every finished act, for a headless runner
+function act(kind, detail, tInput) {
+  return { act: ++actSeq, kind, detail, t_input: tInput, t_handled: null };
+}
+function handled(a) { a.t_handled = performance.now(); return a; }
+// An act's record. `t` carries the request's times where it had one.
+function finish(a, outcome, t) {
+  if (a.outcome) return;
+  a.outcome = outcome;
+  const rec = { act: a.act, kind: a.kind, detail: a.detail, outcome, t_input: r3(a.t_input) };
+  if (outcome !== "overtaken") {
+    const total = t.paint - a.t_input;
+    let engine = 0, transport = 0, browser = total, wait = 0;
+    if (t.send != null) {
+      wait = Math.max(0, t.send - a.t_handled);
+      engine = wait + t.queue + t.engine;
+      transport = (t.body - t.send) - t.queue - t.engine;
+      browser = (a.t_handled - a.t_input) + (t.paint - t.body);
+    }
+    Object.assign(rec, { total: r3(total), engine: r3(engine), transport: r3(transport), browser: r3(browser),
+      parts: { input: r3(a.t_handled - a.t_input), wait: r3(wait), queue: r3(t.queue || 0),
+        engine: r3(t.engine || 0), parse: r3((t.parsed || t.body || 0) - (t.body || 0)),
+        dom: r3((t.dom || 0) - (t.parsed || t.dom || 0)), paint: r3(t.paint - (t.dom || t.paint)),
+        server: t.server || null },
+      basis: t.basis || null, rows: t.rows || 0, req: t.req || null,
+      t_send: t.send != null ? r3(t.send) : null, t_paint: r3(t.paint) });
+    $("#last").textContent = `${a.kind} ${total.toFixed(0)} ms — engine ${engine.toFixed(0)} · transport ${transport.toFixed(0)} · browser ${browser.toFixed(0)}`;
+  }
+  log.push(rec); window.rigActs.push(rec);
+  flush();
+}
+const r3 = (x) => Math.round(x * 1000) / 1000;
+// Each act goes to the log as it is recorded, after its paint, so closing
+// the window loses none; one the server does not take is kept, sent again
+// with the next, and the status bar says so.
+let flushing = false;
+async function flush() {
+  if (flushing || !log.length) return;
+  flushing = true;
+  const batch = log.splice(0);
+  try {
+    const res = await fetch("/api/log", { method: "POST", keepalive: true, body: JSON.stringify(batch) });
+    if (!res.ok) throw new Error(await res.text());
+    window.rigLogged = (window.rigLogged || 0) + batch.length;
+  } catch (e) {
+    log.unshift(...batch);
+    $("#activity").textContent = `${log.length} acts not yet logged: ${e.message || e}`;
+  } finally { flushing = false; if (log.length) setTimeout(flush, 200); }
+}
+addEventListener("pagehide", () => { if (log.length) navigator.sendBeacon("/api/log", JSON.stringify(log.splice(0))); });
+// The paint after a change: the next frame's callbacks run, the frame
+// renders, and a task posted from inside the frame runs once its rendering
+// is done. A change made inside a frame callback is in that frame: the
+// task is posted from there (`inFrame`), never a frame later.
+function afterPaint(cb, inFrame) {
+  const post = () => { const ch = new MessageChannel(); ch.port1.onmessage = () => cb(performance.now()); ch.port2.postMessage(0); };
+  if (inFrame) post(); else requestAnimationFrame(post);
+}
+function serverTiming(h) {
+  const o = { queue: 0, engine: 0 };
+  for (const part of (h || "").split(",")) {
+    const m = part.trim().match(/^(\w+);dur=([\d.]+)/);
+    if (m) o[m[1]] = parseFloat(m[2]);
+  }
+  return o;
+}
+
+// One channel per kind of answer: one request in flight, and the next sent
+// only once the answer before it is painted, so no answer is replaced
+// before its frame; acts that come meanwhile wait together, a later act of
+// a kind overtaking an earlier.
+function channel(send) { return { inflight: false, pending: null, send }; }
+function want(ch, a) {
+  if (ch.pending) {
+    for (const x of ch.pending.acts) if (x.kind === a.kind && a.kind !== "expand") finish(x, "overtaken");
+    ch.pending.acts = ch.pending.acts.filter((x) => !x.outcome);
+    ch.pending.acts.push(a);
+  } else ch.pending = { acts: [a] };
+  if (!ch.inflight) go(ch);
+}
+async function go(ch) {
+  const p = ch.pending; ch.pending = null;
+  if (!p) return;
+  ch.inflight = true;
+  try { await ch.send(p.acts); }
+  catch (e) { for (const a of p.acts) finish(a, "failed", { paint: performance.now() }); $("#activity").textContent = String(e); }
+  finally { ch.inflight = false; if (ch.pending) go(ch); }
+}
+window.rigIdle = () => !viewCh.inflight && !viewCh.pending && !itemCh.inflight && !itemCh.pending && !log.length && !flushing;
+const painted = () => new Promise((resolve) => afterPaint(resolve));
+
+async function ask(path, body) {
+  const t = { send: performance.now() };
+  const res = await fetch(path, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+  t.head = performance.now();
+  const text = await res.text();
+  t.body = performance.now();
+  const data = JSON.parse(text);
+  t.parsed = performance.now();
+  Object.assign(t, serverTiming(res.headers.get("server-timing")));
+  t.server = data.parts || null;
+  t.basis = data.basis || null;
+  return [data, t];
+}
+
+// ---- the view -----------------------------------------------------------
+const viewCh = channel(sendView);
+function windowAround() {
+  const v = Math.ceil(list.clientHeight / ROW) + 1;
+  const first = Math.floor(list.scrollTop / ROW);
+  return { first, v, offset: Math.max(0, first - 10), count: v + 20 };
+}
+function formValue() {
+  const f = { tab: field("tab").value, name: field("name").value, rarity: field("rarity").value,
+    query: field("query").value, min: {}, max: {}, flags: [] };
+  for (const i of form.querySelectorAll("[data-min]")) if (i.value.trim()) f.min[i.dataset.min] = i.value;
+  for (const i of form.querySelectorAll("[data-max]")) if (i.value.trim()) f.max[i.dataset.max] = i.value;
+  for (const c of form.querySelectorAll("input[type=checkbox]")) if (c.checked) f.flags.push(c.value);
+  return f;
+}
+async function sendView(acts) {
+  const w = windowAround();
+  const body = { seq: acts[acts.length - 1].act, league: S.league, mode: S.mode, form: formValue(),
+    collapsed: [...S.collapsed], open: [...S.open], fopen: [...S.fopen], fclosed: [...S.fclosed],
+    sort: S.sort, desc: S.desc, offset: w.offset, count: w.count };
+  const [data, t] = await ask("/api/view", body);
+  t.req = { offset: w.offset, count: w.count };
+  if (data.error) {
+    // a query the search refuses: said where it was typed, the list kept
+    $("#queryerror").textContent = data.error;
+    field("query").classList.add("bad");
+    t.dom = performance.now();
+    const paint = await painted();
+    for (const a of acts) finish(a, "refused", { ...t, paint });
+    return;
+  }
+  $("#queryerror").textContent = ""; field("query").classList.remove("bad");
+  for (const i of form.querySelectorAll("input")) {
+    const k = i.dataset.min ? `min.${i.dataset.min}` : i.dataset.max ? `max.${i.dataset.max}` : null;
+    if (k) i.classList.toggle("bad", !!data.bad[k]);
+  }
+  const queried = data.query != null && S.mode === "tab";
+  if (S.queried && !queried) { S.fopen.clear(); S.fclosed.clear(); }
+  S.queried = queried;
+  held = { basis: data.basis, total: data.total_rows, rows: new Map(data.rows.map((r) => [r.i, r])) };
+  remember();
+  $("#caption").textContent = `Search [${data.caption}]`;
+  spacer.style.height = `${data.total_rows * ROW}px`;
+  draw();
+  t.dom = performance.now();
+  t.rows = data.rows.length;
+  const paint = await painted();
+  for (const a of acts) {
+    // a scroll asked for the rows at its place: answered only if they are
+    // what the viewport shows now
+    if (a.kind === "scroll" && !covered(a.detail.first, a.detail.v)) { finish(a, "overtaken"); continue; }
+    finish(a, "answered", { ...t, paint });
+  }
+}
+function covered(first, v) {
+  const now = windowAround();
+  if (Math.abs(now.first - first) > now.v) return false;
+  for (let i = now.first; i < Math.min(held.total, now.first + now.v); i++) if (!held.rows.has(i)) return false;
+  return true;
+}
+
+// Draw the rows in the viewport from what is held; a row not held yet is
+// a blank slot until its window comes.
+function draw() {
+  const w = windowAround();
+  const lo = Math.max(0, w.first - 2), hi = Math.min(held.total, w.first + w.v + 2);
+  for (const [i, el] of drawn) if (i < lo || i >= hi || el.dataset.key !== key(held.rows.get(i))) { el.remove(); drawn.delete(i); }
+  for (let i = lo; i < hi; i++) {
+    if (drawn.has(i)) { mark(drawn.get(i)); continue; }
+    const r = held.rows.get(i);
+    const el = rowEl(r, i);
+    list.appendChild(el); drawn.set(i, el);
+  }
+}
+const key = (r) => (r ? `${r.k}:${r.id}:${r.open}:${r.n}` : "wait");
+function mark(el) { el.classList.toggle("sel", !!selected && el.dataset.id === selected); }
+function rowEl(r, i) {
+  const el = document.createElement("div");
+  el.style.top = `${i * ROW}px`;
+  el.dataset.i = i; el.dataset.key = key(r);
+  if (!r) { el.className = "r wait"; return el; }
+  el.dataset.id = r.id;
+  // the indent through the style object: the content policy refuses an
+  // inline style attribute
+  if (r.k === "h") {
+    el.className = "r h" + (r.never ? " never" : "");
+    const tw = r.holds ? (r.open ? "▾" : "▸") : "";
+    el.innerHTML = `<span class="name"><span class="tw">${tw}</span>${esc(r.name || r.id)} <span class="n">[${r.n}]</span></span>`;
+  } else {
+    el.className = "r";
+    const name = r.type ? `${esc(r.name)} <span class="base">${esc(r.type)}</span>` : esc(r.name || r.id);
+    el.innerHTML = `<span class="name ${esc(r.rarity || "")}">${name}</span>` +
+      r.v.map((v) => `<span class="num">${v == null ? "" : esc(fmt(v))}</span>`).join("");
+    mark(el);
+  }
+  el.firstChild.style.paddingLeft = `${4 + r.d * 16}px`;
+  return el;
+}
+const fmt = (v) => (typeof v === "number" ? (Number.isInteger(v) ? String(v) : v.toFixed(1)) : typeof v === "object" ? (v.text ?? JSON.stringify(v)) : String(v));
+const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
+
+// ---- inputs -------------------------------------------------------------
+form.addEventListener("input", (e) => {
+  const kind = e.target.matches("input[type=text], input:not([type]), textarea") ? "key" : "form";
+  want(viewCh, handled(act(kind, { field: e.target.name || e.target.dataset.min || e.target.dataset.max || e.target.value, len: (e.target.value || "").length }, e.timeStamp)));
+});
+form.addEventListener("submit", (e) => e.preventDefault());
+$("#mode").addEventListener("change", (e) => {
+  S.mode = e.target.value; list.scrollTop = 0;
+  want(viewCh, handled(act("view", { mode: S.mode }, e.timeStamp)));
+});
+$("#league").addEventListener("change", (e) => {
+  S.league = e.target.value; list.scrollTop = 0;
+  S.open.clear(); S.fopen.clear(); S.fclosed.clear(); S.collapsed.clear();
+  want(viewCh, handled(act("league", { league: S.league }, e.timeStamp)));
+});
+// the column heads: a click orders by the column's value, again reverses
+$("#cols").innerHTML = COLS.map(([n, v], i) => `<span data-c="${i}" class="${i ? "num" : ""}">${n}</span>`).join("");
+$("#cols").addEventListener("click", (e) => {
+  const c = e.target.dataset.c; if (c == null) return;
+  const v = COLS[c][1];
+  if (v === null) { S.sort = null; S.desc = false; }
+  else if (S.sort === v) S.desc = !S.desc;
+  else { S.sort = v; S.desc = true; }
+  for (const s of document.querySelectorAll("#cols span")) { s.classList.toggle("sorted", S.sort === COLS[s.dataset.c][1] && S.sort != null); s.classList.toggle("asc", !S.desc); }
+  want(viewCh, handled(act("sort", { sort: S.sort, desc: S.desc }, e.timeStamp)));
+});
+function toggle(r, e) {
+  const id = r.id;
+  if (r.kind === "folder") S.collapsed.has(id) ? S.collapsed.delete(id) : S.collapsed.add(id);
+  else if (S.queried) {
+    if (r.open) S.fopen.has(id) ? S.fopen.delete(id) : S.fclosed.add(id);
+    else S.fclosed.has(id) ? S.fclosed.delete(id) : S.fopen.add(id);
+  } else S.open.has(id) ? S.open.delete(id) : S.open.add(id);
+  want(viewCh, handled(act("expand", { id, open: !r.open, name: r.name }, e.timeStamp)));
+}
+list.addEventListener("mousedown", (e) => {
+  const el = e.target.closest(".r"); if (!el) return;
+  const r = held.rows.get(+el.dataset.i); if (!r) return;
+  list.focus();
+  if (r.k === "h") { if (r.holds) toggle(r, e); return; }
+  openItem(r, e.timeStamp, "click");
+});
+list.addEventListener("keydown", (e) => {
+  const at = [...held.rows.values()].find((r) => r.id === selected && r.k === "i");
+  if (e.key === "ArrowDown" || e.key === "ArrowUp") {
+    e.preventDefault();
+    const d = e.key === "ArrowDown" ? 1 : -1;
+    let i = at ? at.i + d : windowAround().first;
+    while (held.rows.has(i) && held.rows.get(i).k !== "i") i += d;
+    const r = held.rows.get(i); if (!r) return;
+    if (i * ROW < list.scrollTop) list.scrollTop = i * ROW;
+    if ((i + 1) * ROW > list.scrollTop + list.clientHeight) list.scrollTop = (i + 1) * ROW - list.clientHeight;
+    openItem(r, e.timeStamp, "key-select");
+  }
+});
+// a scroll: once a frame, the rows of the new place drawn from what is
+// held, and a window asked where they are not
+let scrollAct = null;
+list.addEventListener("scroll", (e) => {
+  if (scrollAct) return;
+  scrollAct = act("scroll", null, e.timeStamp);
+  requestAnimationFrame(() => {
+    const a = handled(scrollAct); scrollAct = null;
+    const w = windowAround(); a.detail = { first: w.first, v: w.v, total: held.total };
+    draw();
+    if (covered(w.first, w.v)) {
+      const dom = performance.now();
+      afterPaint((paint) => finish(a, "answered", { paint, dom, rows: 0, basis: held.basis }), true);
+    } else want(viewCh, a);
+  });
+}, { passive: true });
+new ResizeObserver(() => draw()).observe(list);
+
+// ---- the item -----------------------------------------------------------
+const itemCh = channel(sendItem);
+let cardTab = "tip";
+function openItem(r, tInput, kind) {
+  selected = r.id;
+  remember();
+  for (const el of drawn.values()) mark(el);
+  want(itemCh, handled(act(kind === "click" ? "click" : "select", { id: r.id, name: r.name }, tInput)));
+}
+async function sendItem(acts) {
+  const a = acts[acts.length - 1];
+  const [data, t] = await ask("/api/item", { seq: a.act, id: a.detail.id });
+  if (data.error) { $("#activity").textContent = data.error; }
+  else renderCard(data);
+  t.dom = performance.now();
+  const paint = await painted();
+  for (const x of acts) finish(x, x === a ? "answered" : "overtaken", { ...t, paint });
+}
+function renderCard(c) {
+  const name = [c.name, c.typeline].filter(Boolean);
+  $("#cardname").innerHTML = `<span class="${esc(c.rarity || "")}">${name.map(esc).join(" ")}</span>`;
+  const sec = (cls, lines) => (lines.length ? `<div class="sec">${lines.map((l) => `<div class="${cls}">${esc(l)}</div>`).join("")}</div>` : "");
+  const head = `<div class="hdr ${esc(c.rarity || "")}">${name.map((n) => `<div>${esc(n)}</div>`).join("")}</div>`;
+  const props = sec("prop", c.props || []);
+  const req = sec("prop", [c.ilvl, c.requires].filter(Boolean));
+  const groups = (c.groups || []).map((g) => sec(g.source === "explicit" ? "mod" : g.source, g.lines)).join("");
+  const flags = sec("flag", (c.flags || []).filter((f) => ["corrupted", "mirrored", "split", "synthesised"].includes(f)).map((f) => f[0].toUpperCase() + f.slice(1)));
+  const note = sec("note", [c.note, c.descr].filter(Boolean));
+  $("#card").innerHTML = head + props + req + groups + flags + note;
+  const text = [...name, "--------", ...(c.props || []), c.ilvl, c.requires, ...(c.groups || []).flatMap((g) => ["--------", ...g.lines]), c.note].filter(Boolean).join("\n");
+  $("#cardtext").textContent = text;
+  const p = c.place || {};
+  const cell = p.cell ? ` at (${p.cell.x}, ${p.cell.y})` : "";
+  $("#location").textContent = `${p.league || ""} · ${p.parent ? p.parent + " / " : ""}${p.name || ""}${cell}` + (c.price && c.price.effective ? ` · priced` : "");
+  showCardTab();
+}
+function showCardTab() {
+  $("#card").hidden = cardTab !== "tip"; $("#cardtext").hidden = cardTab !== "text";
+  for (const b of document.querySelectorAll("#cardtabs button")) b.classList.toggle("on", b.dataset.t === cardTab);
+}
+$("#cardtabs").addEventListener("click", (e) => { if (e.target.dataset.t) { cardTab = e.target.dataset.t; showCardTab(); } });
+
+// ---- the URL --------------------------------------------------------------
+// The page's identity is its URL (C16): what it asks is written there as it
+// changes, and a reload asks the same. Back is not built: the C++ app has
+// none, and a new search replaces the entry.
+function remember() {
+  const u = new URLSearchParams();
+  u.set("league", S.league); u.set("mode", S.mode);
+  if (S.sort) { u.set("sort", S.sort); if (S.desc) u.set("desc", "1"); }
+  const f = formValue();
+  for (const k of ["tab", "name", "query"]) if (f[k]) u.set(k, f[k]);
+  if (f.rarity && f.rarity !== "any") u.set("rarity", f.rarity);
+  for (const [k, v] of Object.entries(f.min)) u.set(`min.${k}`, v);
+  for (const [k, v] of Object.entries(f.max)) u.set(`max.${k}`, v);
+  for (const x of f.flags) u.append("flag", x);
+  for (const [k, set] of [["collapsed", S.collapsed], ["open", S.open], ["fopen", S.fopen], ["fclosed", S.fclosed]]) for (const id of set) u.append(k, id);
+  if (selected) u.set("item", selected);
+  history.replaceState(null, "", `?${u}`);
+}
+function restore() {
+  const u = new URLSearchParams(location.search);
+  if (u.get("mode")) { S.mode = u.get("mode"); $("#mode").value = S.mode; }
+  S.sort = u.get("sort"); S.desc = u.get("desc") === "1";
+  for (const k of ["tab", "name", "query", "rarity"]) if (u.get(k) != null) field(k).value = u.get(k);
+  for (const i of form.querySelectorAll("[data-min]")) i.value = u.get(`min.${i.dataset.min}`) || "";
+  for (const i of form.querySelectorAll("[data-max]")) i.value = u.get(`max.${i.dataset.max}`) || "";
+  for (const c of form.querySelectorAll("input[type=checkbox]")) c.checked = u.getAll("flag").includes(c.value);
+  for (const [k, set] of [["collapsed", S.collapsed], ["open", S.open], ["fopen", S.fopen], ["fclosed", S.fclosed]]) for (const id of u.getAll(k)) set.add(id);
+  S.queried = u.getAll("fopen").length + u.getAll("fclosed").length > 0;
+  for (const s of document.querySelectorAll("#cols span")) { s.classList.toggle("sorted", S.sort != null && S.sort === COLS[s.dataset.c][1]); s.classList.toggle("asc", !S.desc); }
+  return { league: u.get("league"), item: u.get("item") };
+}
+
+// ---- start --------------------------------------------------------------
+(async () => {
+  const start = act("start", null, performance.now()); handled(start);
+  const [data] = await ask("/api/leagues", {});
+  const leagues = (data.leagues || []).filter((b) => b.bucket === "value");
+  $("#league").innerHTML = leagues.map((b) => `<option value="${esc(b.value)}">${esc(b.value)} (${b.count})</option>`).join("");
+  const was = restore();
+  S.league = leagues.some((b) => b.value === was.league) ? was.league : leagues.length ? leagues[0].value : "Standard";
+  $("#league").value = S.league;
+  $("#activity").textContent = `${data.matched} items in the realm`;
+  want(viewCh, start);
+  if (was.item) { selected = was.item; want(itemCh, handled(act("select", { id: was.item }, performance.now()))); }
+})();
