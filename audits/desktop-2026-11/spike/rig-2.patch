+++ b/spikes/desktop-rig/judge.py
@@ -0,0 +1,103 @@
+"""The desktop spike's bar, applied to a run's or a sitting's log
+(never part of the product; the bar is `audits/desktop-2026-11/spike/README.md`).
+
+    python3 -I judge.py <run.jsonl | acts.jsonl> [--md]
+
+Reads the driver's scenario lines (each carrying its acts and, for the
+scroll, the frames it sampled) or a sitting's log (one act per line), and
+prints, per kind of act, how many were answered, overtaken and refused, the
+totals' median, 90th percentile and worst, the median split, and each line
+of the bar with whether it holds.
+"""
+
+import json
+import sys
+
+
+def pct(xs, p):
+    if not xs:
+        return None
+    xs = sorted(xs)
+    k = min(len(xs) - 1, max(0, round(p / 100 * (len(xs) - 1))))
+    return xs[k]
+
+
+def load(path):
+    acts, frames, jumps = [], [], []
+    for line in open(path):
+        d = json.loads(line)
+        if "scenario" in d:
+            for a in d["acts"]:
+                a["scenario"] = d["scenario"]
+            acts += d["acts"]
+            if d.get("frames"):
+                frames.append(d)
+            if d.get("jumps_from") is not None:
+                jumps.append((d["scenario"], d["jumps_from"]))
+        elif "act" in d:
+            acts.append(d)
+    return acts, frames
+
+
+def judge(acts, frames):
+    out = []
+    kinds = {}
+    for a in acts:
+        kinds.setdefault(a["kind"], []).append(a)
+    out.append("| Act | answered | overtaken | refused | median ms | p90 ms | worst ms | engine | transport | browser |")
+    out.append("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
+    for kind, xs in sorted(kinds.items()):
+        ans = [a for a in xs if a["outcome"] == "answered"]
+        tot = [a["total"] for a in ans]
+        med = lambda f: pct([a[f] for a in ans], 50)
+        fmt = lambda v: "" if v is None else f"{v:.0f}" if v >= 10 else f"{v:.1f}"
+        out.append(
+            f"| {kind} | {len(ans)} | {sum(a['outcome'] == 'overtaken' for a in xs)} | "
+            f"{sum(a['outcome'] == 'refused' for a in xs)} | {fmt(pct(tot, 50))} | {fmt(pct(tot, 90))} | "
+            f"{fmt(max(tot) if tot else None)} | {fmt(med('engine'))} | {fmt(med('transport'))} | {fmt(med('browser'))} |")
+    bar = []
+
+    def line(name, xs, within, all_within, share=0.9):
+        tot = [a["total"] for a in xs if a["outcome"] == "answered"]
+        if not tot:
+            bar.append(f"- {name}: no act answered — not judged")
+            return
+        ok_share = sum(t <= within for t in tot) / len(tot)
+        ok = ok_share >= share and max(tot) <= all_within
+        bar.append(f"- {name}: {sum(t <= within for t in tot)} of {len(tot)} within {within} ms, worst {max(tot):.0f} ms "
+                   f"(all within {all_within} ms asked) — {'holds' if ok else 'MISSES'}")
+
+    # a burst's last keystroke: the act before a pause of half a second
+    keys = sorted([a for a in acts if a["kind"] == "key"], key=lambda a: a["t_input"])
+    last = [a for i, a in enumerate(keys) if i + 1 == len(keys) or keys[i + 1]["t_input"] - a["t_input"] > 500]
+    line("1a. The last keystroke of a burst to its refiltered list", last, 350, 700)
+    line("1b. Every answered keystroke to its list", keys, 700, 700, share=1.0)
+    line("2. A click to the opened item", [a for a in acts if a["kind"] in ("click", "select")], 100, 200)
+    line("3. A place opened or closed to its rows", [a for a in acts if a["kind"] == "expand"], 100, 200)
+    scrolls = [a for a in acts if a["kind"] == "scroll"]
+    line("4a. A scroll to the rows of its place", scrolls, 100, 250)
+    for run in frames:
+        fs = run["frames"]
+        rest, steady = run.get("rest_frames"), run.get("steady_end")
+        gaps = [b - a for a, b in zip(fs, fs[1:])]
+        if not gaps or not rest or not steady:
+            bar.append("- 4b. Frames while scrolling: no frames at rest and in the steady wheel marked — not judged")
+            continue
+        # the display's interval from the frames at rest; lateness over the
+        # steady wheel's frames alone
+        base = pct(gaps[: rest - 1], 50)
+        wheel = gaps[rest - 1 : steady - 1]
+        late = sum(g > 1.5 * base for g in wheel)
+        ok = late <= 0.01 * len(wheel)
+        bar.append(f"- 4b. Frames during the steady wheel: {late} of {len(wheel)} late (an interval over 1.5 × {base:.1f} ms, "
+                   f"the median at rest; at most 1% asked), longest {max(wheel):.0f} ms — {'holds' if ok else 'MISSES'}")
+    return out + [""] + bar
+
+
+def main():
+    acts, frames = load(sys.argv[1])
+    print("\n".join(judge(acts, frames)))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/spikes/desktop-rig/src/main.rs b/spikes/desktop-rig/src/main.rs
