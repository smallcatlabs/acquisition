@@ -0,0 +1,21 @@
+[package]
+name = "desktop-rig"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+publish.workspace = true
+
+# The desktop spike's window (`roadmap/briefs/desktop-spike.md`): a
+# throwaway loopback server and one hand-written page, reading a clone of
+# a store copy. Never part of the product; its record is
+# `audits/desktop-2026-11/spike/README.md`.
+
+[dependencies]
+acquisition-search = { path = "../../crates/acquisition-search" }
+acquisition-store = { path = "../../crates/acquisition-store" }
+acquisition-verbs = { path = "../../crates/acquisition-verbs" }
+tokio.workspace = true
+serde.workspace = true
+serde_json.workspace = true
+anyhow.workspace = true
+axum = { version = "0.8", default-features = false, features = ["http1", "tokio"] }
