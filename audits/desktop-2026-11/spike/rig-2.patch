+#!/bin/zsh
+# The desktop spike's window (audits/desktop-2026-11/spike/README.md).
+# From the repository's root:  runs/desktop-spike/start.sh
+#
+# Each start reads a fresh clone (cp -cR) of the store copy beside this
+# script, never the copy itself and never your own store; starts the rig
+# under the read environment (no daemon, nothing sent to GGG); and opens it
+# as a Chrome app window on a profile of its own here, its background
+# networking off. Close the window to stop. Every act is logged to
+# runs/desktop-spike/logs/sitting-<time>.jsonl.
+set -eu
+here=${0:A:h}
+stamp=$(date +%Y%m%d-%H%M%S)
+work=$here/sittings/$stamp
+mkdir -p $work $here/logs
+cp -cR $here/store-2026-11-24 $work/store
+log=$here/logs/sitting-$stamp.jsonl
+env -u ACQ_PROVIDER -u ACQ_GGG ACQ_NO_SPAWN=1 ACQ_NO_KEYRING=1 \
+  ACQ_STORE_DIR=$work/store ACQ_LOG_DIR=$work/logs \
+  $here/rig/desktop-rig --account 'GERWARIC#7694' --log $log >$work/url 2>$work/rig.err &
+rig=$!
+trap 'kill $rig 2>/dev/null || true' EXIT INT TERM
+print "Loading your items…"
+until [[ -s $work/url ]]; do
+  kill -0 $rig 2>/dev/null || { cat $work/rig.err; exit 1; }
+  sleep 0.2
+done
+url=$(head -1 $work/url)
+print "The window: $url"
+print "Its acts are logged to ${log#$PWD/}"
+chrome=${ACQ_TEST_BROWSER:-"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"}
+"$chrome" --user-data-dir=$here/profile --app=$url --window-size=1280,760 \
+  --no-first-run --no-default-browser-check --disable-background-networking \
+  --disable-component-update --disable-sync --disable-extensions \
+  ${=RIG_BROWSER_ARGS:-} >/dev/null 2>&1
+# the page's last acts reach the log as the window closes
+sleep 1
