diff --git a/spikes/desktop-rig/drive.py b/spikes/desktop-rig/drive.py
new file mode 100644
index 00000000..e7ae37fa
--- /dev/null
+++ b/spikes/desktop-rig/drive.py
@@ -0,0 +1,343 @@
+"""The desktop spike's headless runs (never part of the product; its record
+is `audits/desktop-2026-11/spike/README.md`).
+
+    python3 -I drive.py <rig URL> <profile dir> <out.jsonl> [scenario,...]
+
+Starts headless Chrome on the profile directory given (never a person's
+own) at the C++ app's window size, 1280 x 720, loads the rig's window, and
+plays each scenario as a person's input through Chrome's debugging protocol
+(`Input.dispatchKeyEvent`, `Input.dispatchMouseEvent`): trusted events,
+which the page times as it times the owner's. The page's own act log
+(`window.rigActs`) is the measurement; the runner adds the frames it saw
+while scrolling (an animation-frame sampler it installs) and appends one
+JSON line per scenario. Standard library alone; every call has a deadline.
+"""
+
+import base64
+import json
+import os
+import shutil
+import socket
+import struct
+import subprocess
+import sys
+import time
+
+CHROME = os.environ.get("ACQ_TEST_BROWSER", "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
+ANSWER = 30
+W, H = 1280, 720
+
+
+def deadline_left(deadline, what):
+    left = deadline - time.monotonic()
+    if left <= 0:
+        raise TimeoutError(f"{what}: the deadline passed")
+    return left
+
+
+def http_json(port, path, deadline):
+    s = socket.create_connection(("127.0.0.1", int(port)), timeout=deadline_left(deadline, path))
+    try:
+        s.sendall(f"GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nConnection: close\r\n\r\n".encode())
+        data = b""
+        while True:
+            s.settimeout(deadline_left(deadline, path))
+            chunk = s.recv(65536)
+            if not chunk:
+                break
+            data += chunk
+            head, _, body = data.partition(b"\r\n\r\n")
+            length = [int(l.split(b":")[1]) for l in head.split(b"\r\n") if l.lower().startswith(b"content-length:")]
+            if length and len(body) >= length[0]:
+                break
+        return json.loads(data.partition(b"\r\n\r\n")[2])
+    finally:
+        s.close()
+
+
+class Socket:
+    """One websocket to a debugging target: text frames, masked out."""
+
+    def __init__(self, url):
+        hostport, path = url.split("://", 1)[1].split("/", 1)
+        host, port = hostport.split(":")
+        self.s = socket.create_connection((host, int(port)), timeout=ANSWER)
+        key = base64.b64encode(os.urandom(16)).decode()
+        self.s.sendall(
+            (f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
+             f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
+        head = b""
+        while b"\r\n\r\n" not in head:
+            head += self.s.recv(1)
+        if b" 101 " not in head.split(b"\r\n")[0]:
+            raise RuntimeError(head.decode(errors="replace"))
+        self.next = 0
+
+    def _exact(self, n, deadline):
+        out = b""
+        while len(out) < n:
+            self.s.settimeout(deadline_left(deadline, "debugging call"))
+            chunk = self.s.recv(n - len(out))
+            if not chunk:
+                raise RuntimeError("the target closed its socket")
+            out += chunk
+        return out
+
+    def _send(self, obj, deadline):
+        data = json.dumps(obj).encode()
+        mask = os.urandom(4)
+        n = len(data)
+        if n < 126:
+            head = struct.pack("!BB", 0x81, 0x80 | n)
+        elif n < 65536:
+            head = struct.pack("!BBH", 0x81, 0x80 | 126, n)
+        else:
+            head = struct.pack("!BBQ", 0x81, 0x80 | 127, n)
+        self.s.settimeout(deadline_left(deadline, "debugging call"))
+        self.s.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))
+
+    def _receive(self, deadline):
+        message = b""
+        while True:
+            b0, b1 = self._exact(2, deadline)
+            n = b1 & 0x7F
+            if n == 126:
+                (n,) = struct.unpack("!H", self._exact(2, deadline))
+            elif n == 127:
+                (n,) = struct.unpack("!Q", self._exact(8, deadline))
+            payload = self._exact(n, deadline)
+            if b0 & 0x0F in (0x9, 0xA):
+                continue
+            message += payload
+            if b0 & 0x80:
+                return json.loads(message)
+
+    def call(self, method, **params):
+        deadline = time.monotonic() + ANSWER
+        self.next += 1
+        mine = self.next
+        self._send({"id": mine, "method": method, "params": params}, deadline)
+        while True:
+            reply = self._receive(deadline)
+            if reply.get("id") == mine:
+                if "error" in reply:
+                    raise RuntimeError(reply["error"])
+                return reply.get("result", {})
+
+    def js(self, expression):
+        r = self.call("Runtime.evaluate", expression=expression, returnByValue=True, awaitPromise=True)
+        if "exceptionDetails" in r:
+            raise RuntimeError(r["exceptionDetails"])
+        return r["result"].get("value")
+
+
+# ---- input ------------------------------------------------------------------
+
+def key(ws, ch):
+    """One character typed: a key down carrying its text, then up."""
+    if ch == "\b":
+        args = dict(key="Backspace", code="Backspace", windowsVirtualKeyCode=8)
+        ws.call("Input.dispatchKeyEvent", type="rawKeyDown", **args)
+        ws.call("Input.dispatchKeyEvent", type="keyUp", **args)
+        return
+    ws.call("Input.dispatchKeyEvent", type="keyDown", text=ch, key=ch, unmodifiedText=ch)
+    ws.call("Input.dispatchKeyEvent", type="keyUp", key=ch)
+
+
+def click(ws, x, y):
+    for t in ("mousePressed", "mouseReleased"):
+        ws.call("Input.dispatchMouseEvent", type=t, x=x, y=y, button="left", clickCount=1)
+
+
+def wheel(ws, x, y, dy):
+    ws.call("Input.dispatchMouseEvent", type="mouseWheel", x=x, y=y, deltaX=0, deltaY=dy)
+
+
+def idle(ws, limit=20.0):
+    end = time.monotonic() + limit
+    while time.monotonic() < end:
+        if ws.js("window.rigIdle && window.rigIdle()"):
+            return True
+        time.sleep(0.05)
+    return False
+
+
+def box(ws, selector):
+    return ws.js(f"(() => {{ const e = document.querySelector({json.dumps(selector)}); if (!e) return null; e.scrollIntoView({{block: 'nearest'}});"
+                 " const r = e.getBoundingClientRect(); return {x: r.x + r.width / 2, y: r.y + r.height / 2}; })()")
+
+
+def type_into(ws, selector, text, gap):
+    b = box(ws, selector)
+    click(ws, b["x"], b["y"])
+    for ch in text:
+        key(ws, ch)
+        time.sleep(gap)
+    idle(ws)
+    time.sleep(0.5)
+
+
+def clear(ws, selector, gap=0.12):
+    n = ws.js(f"document.querySelector({json.dumps(selector)}).value.length")
+    b = box(ws, selector)
+    click(ws, b["x"], b["y"])
+    ws.js(f"(() => {{ const e = document.querySelector({json.dumps(selector)}); e.setSelectionRange(e.value.length, e.value.length); }})()")
+    for _ in range(n):
+        key(ws, "\b")
+        time.sleep(gap)
+    idle(ws)
+    time.sleep(0.5)
+
+
+def rows(ws, which):
+    """The centres of the drawn rows in the viewport: `h` heads, `i` items."""
+    return ws.js(
+        "(() => { const l = document.querySelector('#list').getBoundingClientRect(); return [...document.querySelectorAll('#list .r')]"
+        f".filter(e => !e.classList.contains('wait') && e.classList.contains('h') === {json.dumps(which == 'h')})"
+        ".map(e => { const r = e.getBoundingClientRect(); return {x: r.x + 120, y: r.y + r.height / 2, i: +e.dataset.i, id: e.dataset.id}; })"
+        ".filter(p => p.y > l.top + 4 && p.y < l.bottom - 4).sort((a, b) => a.y - b.y); })()")
+
+
+# ---- scenarios -----------------------------------------------------------------
+
+def keystrokes(ws):
+    """Typing into the form at a person's pace, and fast; each word then
+    cleared."""
+    for sel, text, gap in [
+        ("input[name=name]", "tabula", 0.15),
+        ("input[name=name]", "chaos orb", 0.06),
+        ("input[name=tab]", "dump", 0.15),
+        ("textarea[name=query]", "pseudo.total_life>=70", 0.10),
+        ("textarea[name=query]", "rarity=unique ilvl>=80", 0.10),
+    ]:
+        type_into(ws, sel, text, gap)
+        clear(ws, sel)
+
+
+def heads(ws, is_open):
+    """The drawn heads in the viewport that hold places or items, open or
+    closed, by the row the page drew."""
+    return [h for h in rows(ws, "h") if ws.js(
+        f"(() => {{ const e = document.querySelector('#list .r.h[data-i=\"{h['i']}\"] .tw'); return !!e && e.textContent === {json.dumps('\u25be' if is_open else '\u25b8')}; }})()")]
+
+
+def expansions(ws):
+    """Tab heads opened and closed with no query: the first closed heads in
+    view, six, each then closed; twice."""
+    ws.js("document.querySelector('#list').scrollTop = 0")
+    time.sleep(0.5)
+    for _ in range(2):
+        for _ in range(6):
+            closed = heads(ws, False)
+            if not closed:
+                break
+            pick = closed[min(len(closed) - 1, 2)]
+            click(ws, pick["x"], pick["y"])
+            idle(ws)
+            time.sleep(0.6)
+        for _ in range(6):
+            opened = heads(ws, True)
+            if not opened:
+                break
+            click(ws, opened[0]["x"], opened[0]["y"])
+            idle(ws)
+            time.sleep(0.6)
+
+
+def clicks(ws):
+    """Items opened by a click, in the tree under a query and in the flat
+    list."""
+    type_into(ws, "textarea[name=query]", "rarity=unique", 0.0)
+    for _ in range(10):
+        items = rows(ws, "i")
+        if not items:
+            break
+        pick = items[min(len(items) - 1, 3 + _ * 2)]
+        click(ws, pick["x"], pick["y"])
+        idle(ws)
+        time.sleep(0.6)
+    clear(ws, "textarea[name=query]", 0.0)
+
+
+def scroll(ws):
+    """The largest list, the flat list of the league: a steady wheel at
+    1,500 px a second for 10 s, then ten jumps, as dragging the thumb."""
+    ws.js("(() => { const m = document.querySelector('#mode'); m.value = 'item'; m.dispatchEvent(new Event('change')); })()")
+    idle(ws)
+    time.sleep(1)
+    b = box(ws, "#list")
+    # the frames: first a second and a half at rest, whose median interval
+    # is the display's; then the steady wheel alone, its frames counted
+    # apart from the jumps that follow
+    ws.js("window.rigFrames = []; (function f(t) { window.rigFrames.push(t); if (window.rigFrames.length < 20000) requestAnimationFrame(f); })(performance.now())")
+    time.sleep(1.5)
+    rest = ws.js("window.rigFrames.length")
+    end = time.monotonic() + 10
+    while time.monotonic() < end:
+        wheel(ws, b["x"], b["y"], 25)
+        time.sleep(1 / 60)
+    steady = ws.js("window.rigFrames.length")
+    idle(ws)
+    time.sleep(0.5)
+    jumps_from = ws.js("window.rigActs.length")
+    for f in (0.5, 0.1, 0.9, 0.25, 1, 0.75, 0.37, 0.61, 0.83, 0):
+        ws.js(f"(() => {{ const l = document.querySelector('#list'); l.scrollTop = Math.round((l.scrollHeight - l.clientHeight) * {f}); }})()")
+        idle(ws)
+        time.sleep(0.5)
+    frames = ws.js("window.rigFrames")
+    ws.js("window.rigFrames.length = 20000")
+    ws.js("(() => { const m = document.querySelector('#mode'); m.value = 'tab'; m.dispatchEvent(new Event('change')); })()")
+    idle(ws)
+    return {"frames": frames, "rest_frames": rest, "steady_end": steady, "jumps_from": jumps_from}
+
+
+SCENARIOS = {"keystrokes": keystrokes, "expansions": expansions, "clicks": clicks, "scroll": scroll}
+
+
+def main():
+    url, profile, out = sys.argv[1], sys.argv[2], sys.argv[3]
+    wanted = sys.argv[4].split(",") if len(sys.argv) > 4 else list(SCENARIOS)
+    shutil.rmtree(profile, ignore_errors=True)
+    os.makedirs(profile)
+    chrome = subprocess.Popen(
+        [CHROME, "--headless=new", f"--user-data-dir={profile}", "--remote-debugging-port=0",
+         f"--window-size={W},{H}", "--no-first-run", "--no-default-browser-check",
+         "--disable-background-networking", "--disable-component-update", "--disable-sync",
+         "--disable-extensions", "--metrics-recording-only", "about:blank"],
+        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    try:
+        deadline = time.monotonic() + 2 * ANSWER
+        port_file = os.path.join(profile, "DevToolsActivePort")
+        while not (os.path.exists(port_file) and open(port_file).read().strip()):
+            deadline_left(deadline, "the browser's port file")
+            time.sleep(0.1)
+        port = open(port_file).read().split()[0]
+        page = next(t for t in http_json(port, "/json/list", deadline) if t["type"] == "page")
+        ws = Socket(page["webSocketDebuggerUrl"])
+        ws.call("Page.navigate", url=url)
+        end = time.monotonic() + ANSWER
+        while not ws.js("!!(window.rigActs && window.rigActs.length && window.rigIdle())"):
+            deadline_left(end, "the window's first view")
+            time.sleep(0.1)
+        meta = ws.js("({ua: navigator.userAgent, w: innerWidth, h: innerHeight, dpr: devicePixelRatio})")
+        for name in wanted:
+            before = ws.js("window.rigActs.length")
+            started = time.time()
+            extra = SCENARIOS[name](ws) or {}
+            idle(ws)
+            time.sleep(1.2)  # the page's log flush
+            acts = ws.js(f"window.rigActs.slice({before})")
+            with open(out, "a") as sink:
+                sink.write(json.dumps({"scenario": name, "started": started, "meta": meta,
+                                       "acts": acts, **extra}) + "\n")
+            print(name, len(acts), "acts", flush=True)
+    finally:
+        chrome.terminate()
+        try:
+            chrome.wait(10)
+        except subprocess.TimeoutExpired:
+            chrome.kill()
+
+
+if __name__ == "__main__":
+    main()
