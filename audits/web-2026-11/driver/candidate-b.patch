+// ---- the browser (the browser-driven check's driver, candidate (b)) ----
+
+/// The browser's executable: `ACQ_TEST_BROWSER`, or the first installed
+/// of the Chromium family's usual places; none fails the test.
+fn browser_exe() -> PathBuf {
+    if let Some(path) = std::env::var_os("ACQ_TEST_BROWSER") {
+        return path.into();
+    }
+    let home = std::env::var("HOME").unwrap_or_default();
+    [
+        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome".to_string(),
+        "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser".to_string(),
+        format!("{home}/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"),
+        "/usr/bin/google-chrome".to_string(),
+        "/usr/bin/chromium".to_string(),
+    ]
+    .into_iter()
+    .map(PathBuf::from)
+    .find(|p| p.exists())
+    .expect("no browser: set ACQ_TEST_BROWSER to a Chromium-family browser's executable")
+}
+
+/// A headless browser the test owns, killed when it ends, and the port
+/// its debugging protocol listens on.
+pub struct Browser {
+    child: std::process::Child,
+    pub port: String,
+}
+
+impl Drop for Browser {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+/// The browser started headless on `profile`, under the one isolation
+/// list, its debugging port read from the file it writes there: no wait
+/// but the hang ceiling (C137).
+pub fn start_browser(profile: &Path) -> Browser {
+    let mut cmd = Command::new(browser_exe());
+    cmd.args([
+        "--headless=new",
+        &format!("--user-data-dir={}", profile.display()),
+        "--remote-debugging-port=0",
+        "--no-first-run",
+        "--no-default-browser-check",
+        "about:blank",
+    ])
+    .stdout(std::process::Stdio::null())
+    .stderr(std::process::Stdio::null());
+    isolate_at(&mut cmd, profile, profile);
+    let child = cmd.spawn().expect("starting the browser");
+    let port_file = profile.join("DevToolsActivePort");
+    let port = loop {
+        if let Ok(text) = std::fs::read_to_string(&port_file)
+            && let Some(port) = text.lines().next().filter(|p| !p.is_empty())
+        {
+            break port.to_string();
+        }
+        std::thread::sleep(std::time::Duration::from_millis(50));
+    };
+    Browser { child, port }
+}
