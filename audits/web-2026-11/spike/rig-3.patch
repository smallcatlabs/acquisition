diff --git a/crates/acquisition-cli/src/web/rig.rs b/crates/acquisition-cli/src/web/rig.rs
new file mode 100644
index 00000000..f960bd00
--- /dev/null
+++ b/crates/acquisition-cli/src/web/rig.rs
@@ -0,0 +1,499 @@
+//! The window rig (4-full part 1, step 6.3's spike,
+//! `roadmap/briefs/4-full-1-step6-spike.md`): never committed as code;
+//! its record and patch are `audits/web-2026-11/spike/`.
+//!
+//! A table is a page of segments, each a run of rows of one height
+//! asked by an offset and a count: flat, one segment of the answer's
+//! rows; grouped, the league's tabs as head rows, and an opened tab's
+//! rows a segment between the heads before it and the heads after it.
+//! The server renders every row and says each segment's route and count;
+//! `window.js` turns the scroll into blocks asked of those routes and
+//! keeps the blocks near the viewport. `measure.js`, loaded only with
+//! `measure` in the URL, drives and measures it.
+//!
+//! - `table?realm&text[&group=tabs&league[&open=<tab id>]][&measure]`
+//! - `window?next=<token>&offset&count`: rows of a request at its basis,
+//!   `after` the offset and `limit` the count, the answer's bounds
+//!   applying (`ITEM_ROWS` under `item`); a moved basis is a 409.
+//! - `heads?realm&league&next=<token>&offset&count[&open][&text]`: the
+//!   tabs listing's rows from the offset, the token's basis checked
+//!   first. The listing is held for the basis it was read at, as the
+//!   corpus is held (rig-2): a window of heads is a slice of it, and a
+//!   moved basis reads it again.
+//!
+//! - `POST result`: a run's result, as the measure sends it when the run
+//!   ends (rig-3), appended as one line to the file `ACQ_RIG_RESULTS`
+//!   names, with the time, the case, the browser's user agent as its
+//!   request says it and its window as the page measured it.
+//!
+//! Either window answers the JSON a truth check reads where JSON is
+//! asked.
+
+use super::*;
+use acquisition_search::answer::{Shape, ViewOut};
+
+/// The row height, in CSS pixels: the one source the script and the
+/// stylesheet read (`data-h`, the script's `--row`).
+const ROW: u32 = 24;
+
+pub(super) const WINDOW: &str = include_str!("assets/window.js");
+pub(super) const MEASURE: &str = include_str!("assets/measure.js");
+
+/// The tabs listing of a realm's league, held for the basis it was read
+/// at (rig-2): the rows in the listing's order.
+pub(super) struct Listing {
+    realm: String,
+    league: String,
+    basis: acquisition_search::Basis,
+    rows: Arc<Vec<acquisition_store::TabRow>>,
+}
+
+/// The league's listing at `basis`: the one held where it was read at
+/// that basis, else read now (`Tabs::read`, every tab) and held in its
+/// place. The lock is held through a read, so the windows a jump asks
+/// together read it once.
+fn listing(
+    web: &Web,
+    realm: &str,
+    league: &str,
+    basis: &acquisition_search::Basis,
+) -> Result<Arc<Vec<acquisition_store::TabRow>>, Failure> {
+    let mut slot = web
+        .listing
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(held) = slot.as_ref()
+        && held.realm == realm
+        && held.league == league
+        && &held.basis == basis
+    {
+        return Ok(Arc::clone(&held.rows));
+    }
+    let facts = web.served()?.facts()?;
+    let rows = Arc::new(
+        acquisition_search::tabs::Tabs::read(
+            &facts,
+            realm,
+            league,
+            &acquisition_search::tabs::Selection::default(),
+            None,
+            true,
+            acquisition_store::now(),
+        )?
+        .0
+        .rows,
+    );
+    *slot = Some(Listing {
+        realm: realm.to_string(),
+        league: league.to_string(),
+        basis: basis.clone(),
+        rows: Arc::clone(&rows),
+    });
+    Ok(rows)
+}
+
+/// A rows request as the rig asks it: the query over the realm, a row's
+/// item asked for its price.
+fn rows_request(realm: &str, text: &str) -> Result<Request, Failure> {
+    let mut query = serde_json::Map::new();
+    if !text.trim().is_empty() {
+        query.insert("text".into(), json!(text));
+    }
+    serde_json::from_value(json!({
+        "scope": { "realm": realm },
+        "query": query,
+        "view": { "rows": { "limit": 1, "fields": ["item"] } },
+    }))
+    .map_err(|e| Failure::Usage(e.to_string()))
+}
+
+/// The request continued at the answer's basis, from its first row: the
+/// token a segment's route carries.
+fn at_basis(mut request: Request, answer: &acquisition_search::Answer) -> String {
+    request.basis = Some(answer.basis.clone());
+    if let Shape::Rows(rows) = &mut request.view.shape {
+        rows.after = Some(0);
+    }
+    request.token()
+}
+
+fn field<'a>(fields: &'a [(String, String)], name: &str) -> &'a str {
+    pick(fields, name).unwrap_or("")
+}
+
+fn number(fields: &[(String, String)], name: &str) -> Result<usize, Failure> {
+    field(fields, name)
+        .parse()
+        .map_err(|_| Failure::Usage(format!("`{name}` is a number of rows")))
+}
+
+/// One segment: its route (to which the script adds the offset and the
+/// count), its rows, and the offset of its first row in that route's
+/// order.
+fn segment(class: &str, route: &str, count: usize, base: usize) -> String {
+    format!(
+        "<div class=\"seg {class}\" data-route=\"{}\" data-count=\"{count}\" data-base=\"{base}\"></div>\n",
+        esc(route)
+    )
+}
+
+/// The rig's page.
+pub(super) async fn table(
+    State(web): State<Arc<Web>>,
+    headers: HeaderMap,
+    Query(fields): Query<Fields>,
+) -> Response {
+    let measure = pick(&fields, "measure").is_some();
+    let built = blocking(&web, move |web| -> Result<(String, String), Failure> {
+        let realm = pick(&fields, "realm").unwrap_or("pc").to_string();
+        let text = field(&fields, "text").to_string();
+        let mut link = vec![("realm", realm.clone()), ("text", text.clone())];
+        if pick(&fields, "group") != Some("tabs") {
+            let request = rows_request(&realm, &text)?;
+            let answer = web.answer(&request)?;
+            let values = match &answer.view {
+                ViewOut::Rows(rows) => rows.values.clone(),
+                _ => Vec::new(),
+            };
+            let route = web.link("window", &[("next", at_basis(request, &answer))]);
+            let total = answer.total.matched;
+            let heads: String = ["Item", "Base", "Price", "Location"]
+                .iter()
+                .map(|h| h.to_string())
+                .chain(values.iter().cloned())
+                .map(|h| format!("<span>{}</span>", esc(&h)))
+                .collect();
+            let body = format!(
+                "<p>{total} rows, flat: <code>{}</code></p>\n<div class=\"rig items\" data-h=\"{ROW}\" data-values=\"{}\">\n<div class=\"r head\">{heads}</div>\n{}</div>\n",
+                esc(if text.is_empty() { "(every item)" } else { &text }),
+                values.len(),
+                segment("rows", &route, total, 0)
+            );
+            return Ok((format!("Rig · {total} rows"), body));
+        }
+        let league = pick(&fields, "league").unwrap_or("Standard").to_string();
+        link.push(("group", "tabs".into()));
+        link.push(("league", league.clone()));
+        // the basis the heads are read at: the realm's answer, whose
+        // basis moves when a fetch or a listing lands
+        let scope = rows_request(&realm, "")?;
+        let scope_answer = web.answer(&scope)?;
+        let basis = at_basis(scope, &scope_answer);
+        let rows = listing(web, &realm, &league, &scope_answer.basis)?;
+        let all = rows.len();
+        let open = pick(&fields, "open").map(str::to_string);
+        let mut heads_route = link.clone();
+        heads_route.push(("next", basis));
+        if let Some(open) = &open {
+            heads_route.push(("open", open.clone()));
+        }
+        let heads_route = web.link("heads", &heads_route);
+        let opened = open
+            .as_deref()
+            .and_then(|id| rows.iter().position(|row| row.id == id));
+        let mut segments = String::new();
+        // the league is the URL's word: escaped where the page writes it
+        let named = esc(&league);
+        let mut said = format!("{all} tabs of {named}, none open");
+        match opened {
+            None => segments.push_str(&segment("heads", &heads_route, all, 0)),
+            Some(at) => {
+                let tab = &rows[at];
+                let place = format!("id:{} league=\"{}\"", tab.id, league.replace('"', ""));
+                let scoped = match text.trim() {
+                    "" => place,
+                    text => format!("({text}) {place}"),
+                };
+                let request = rows_request(&realm, &scoped)?;
+                let answer = web.answer(&request)?;
+                let route = web.link("window", &[("next", at_basis(request, &answer))]);
+                let m = answer.total.matched;
+                said = format!(
+                    "{all} tabs of {named}, {} open with its {m} rows: <code>{}</code>",
+                    esc(&tab.name),
+                    esc(&scoped)
+                );
+                segments.push_str(&segment("heads", &heads_route, at + 1, 0));
+                segments.push_str(&segment("rows", &route, m, 0));
+                segments.push_str(&segment("heads", &heads_route, all - at - 1, at + 1));
+            }
+        }
+        let body = format!(
+            "<p>{said}</p>\n<div class=\"rig grouped\" data-h=\"{ROW}\">\n<div class=\"r head\"><span>Tab · item</span><span>Type · base</span><span>Items · price</span><span>Fetched · location</span></div>\n{segments}</div>\n"
+        );
+        Ok((format!("Rig · {all} tabs"), body))
+    })
+    .await;
+    match built {
+        Ok((title, body)) => web.page(
+            &title,
+            Head {
+                window: true,
+                measure,
+                ..Head::default()
+            },
+            &body,
+        ),
+        Err(failure) => web.failed("Rig", &failure, &headers),
+    }
+}
+
+/// A refusal of a window: a moved basis a 409, which the script answers
+/// by loading its page again; any other its words, in the block.
+fn window_refused(web: &Web, failure: &Failure, headers: &HeaderMap) -> Response {
+    let doc = web.refusal(failure);
+    let status = match doc["kind"].as_str() {
+        Some("basis_changed") => StatusCode::CONFLICT,
+        _ => StatusCode::BAD_REQUEST,
+    };
+    if wants_json(headers) {
+        return (
+            status,
+            [(header::CONTENT_TYPE, "application/json")],
+            doc.to_string(),
+        )
+            .into_response();
+    }
+    let words = doc["error"].as_str().unwrap_or("refused").to_string();
+    (
+        status,
+        [(header::CONTENT_TYPE, "text/html; charset=utf-8")],
+        format!("<p class=\"refused\">{}</p>", esc(&words)),
+    )
+        .into_response()
+}
+
+/// What a window's server time went to, as a `Server-Timing` header the
+/// measure reads from the browser's resource timing.
+#[derive(Default)]
+struct Timing(Vec<(&'static str, f64)>);
+
+impl Timing {
+    fn time<T>(&mut self, name: &'static str, work: impl FnOnce() -> T) -> T {
+        let began = std::time::Instant::now();
+        let out = work();
+        self.took(name, began);
+        out
+    }
+
+    fn took(&mut self, name: &'static str, began: std::time::Instant) {
+        self.0.push((name, began.elapsed().as_secs_f64() * 1000.0));
+    }
+
+    fn header(&self) -> String {
+        self.0
+            .iter()
+            .map(|(name, ms)| format!("{name};dur={ms:.2}"))
+            .collect::<Vec<_>>()
+            .join(", ")
+    }
+}
+
+fn fragment(body: String, timing: &Timing) -> Response {
+    let mut response = ([(header::CONTENT_TYPE, "text/html; charset=utf-8")], body).into_response();
+    if let Ok(value) = HeaderValue::from_str(&timing.header()) {
+        response.headers_mut().insert("server-timing", value);
+    }
+    response
+}
+
+/// The rows of a request at its basis, from `offset`, `count` of them.
+pub(super) async fn window(
+    State(web): State<Arc<Web>>,
+    headers: HeaderMap,
+    Query(fields): Query<Fields>,
+) -> Response {
+    let json = wants_json(&headers);
+    let asked = blocking(&web, move |web| -> Result<_, Failure> {
+        let mut request = Request::from_token(field(&fields, "next"))?;
+        let (offset, count) = (number(&fields, "offset")?, number(&fields, "count")?);
+        if let Shape::Rows(rows) = &mut request.view.shape {
+            rows.after = Some(offset);
+            rows.limit = Some(count);
+        }
+        // `Web::answer`'s three steps, each timed for the measure
+        let mut timing = Timing::default();
+        request.check()?;
+        let opened = timing.time("open", || web.served()?.open().map_err(Failure::from))?;
+        let corpus = timing.time("corpus", || {
+            web.held
+                .corpus(&request, &opened.facts, &opened.intent)
+                .map_err(Failure::from)
+        })?;
+        let answer = timing.time("answer", || {
+            acquisition_search::answer(&corpus, &request).map_err(Failure::from)
+        })?;
+        Ok((offset, answer, timing))
+    })
+    .await;
+    let (offset, answer, mut timing) = match asked {
+        Ok(asked) => asked,
+        Err(failure) => return window_refused(&web, &failure, &headers),
+    };
+    if json {
+        return document(&json!({
+            "offset": offset,
+            "ids": answer.rows.iter().map(|r| r.id.as_str()).collect::<Vec<_>>(),
+        }));
+    }
+    let began = std::time::Instant::now();
+    let now = acquisition_store::now();
+    let mut out = String::new();
+    for (n, row) in answer.rows.iter().enumerate() {
+        let name = crate::search_cmd::title(row.name.as_deref(), row.typeline.as_deref());
+        let price = match row.shown.as_ref().map(|s| &s.price) {
+            Some(acquisition_search::Priced::Is(p)) => p.text.clone(),
+            _ => String::new(),
+        };
+        let values: String = row
+            .values
+            .iter()
+            .map(|v| {
+                let text = match &v.value {
+                    Some(Value::String(s)) => s.clone(),
+                    Some(value) => value.to_string(),
+                    None => v.status.unwrap_or("").to_string(),
+                };
+                format!("<span>{}</span>", esc(&text))
+            })
+            .collect();
+        let rarity = row.rarity.as_deref().unwrap_or("").to_lowercase();
+        out.push_str(&format!(
+            "<div class=\"r\" data-i=\"{}\" data-id=\"{}\"><a class=\"rarity-{}\" href=\"item/{}\">{}</a><span>{}</span><span>{}</span><span>{}</span>{values}</div>\n",
+            offset + n,
+            esc(&row.id),
+            esc(&rarity),
+            enc(&row.id),
+            esc(&name),
+            esc(row.base.as_deref().unwrap_or("")),
+            esc(&price),
+            esc(&crate::search_cmd::place_text(&row.place, now)),
+        ));
+    }
+    timing.took("render", began);
+    fragment(out, &timing)
+}
+
+/// The league's tabs from `offset`, `count` of them, as head rows: each a
+/// link that opens it, the opened one's closing it.
+pub(super) async fn heads(
+    State(web): State<Arc<Web>>,
+    headers: HeaderMap,
+    Query(fields): Query<Fields>,
+) -> Response {
+    let json = wants_json(&headers);
+    let read = blocking(&web, move |web| -> Result<_, Failure> {
+        // the basis first: a listing read past a moved one is refused, as
+        // a continuation's rows are, by the held corpus's basis
+        let mut timing = Timing::default();
+        let check = Request::from_token(field(&fields, "next"))?;
+        let opened = timing.time("open", || web.served()?.open().map_err(Failure::from))?;
+        let corpus = timing.time("corpus", || {
+            web.held
+                .corpus(&check, &opened.facts, &opened.intent)
+                .map_err(Failure::from)
+        })?;
+        if check.basis.as_ref() != Some(&corpus.basis) {
+            // the search's own refusal of a place at another basis
+            acquisition_search::answer(&corpus, &check)?;
+        }
+        let began = std::time::Instant::now();
+        let (offset, count) = (number(&fields, "offset")?, number(&fields, "count")?);
+        let realm = pick(&fields, "realm").unwrap_or("pc").to_string();
+        let league = pick(&fields, "league").unwrap_or("Standard").to_string();
+        // a slice of the listing held at the basis just checked
+        let listed = listing(web, &realm, &league, &corpus.basis)?;
+        let count = count.min(acquisition_store::bound::ITEM_ROWS);
+        let rows: Vec<_> = listed.iter().skip(offset).take(count).cloned().collect();
+        timing.took("listing", began);
+        Ok((offset, rows, fields, timing))
+    })
+    .await;
+    let (offset, rows, fields, mut timing) = match read {
+        Ok(read) => read,
+        Err(failure) => return window_refused(&web, &failure, &headers),
+    };
+    if json {
+        return document(&json!({
+            "offset": offset,
+            "ids": rows.iter().map(|r| r.id.as_str()).collect::<Vec<_>>(),
+        }));
+    }
+    let began = std::time::Instant::now();
+    let now = acquisition_store::now();
+    let open = pick(&fields, "open");
+    let base: Vec<(&str, String)> = ["realm", "text", "league"]
+        .iter()
+        .map(|k| (*k, field(&fields, k).to_string()))
+        .chain([("group", "tabs".to_string())])
+        .collect();
+    let mut out = String::new();
+    for (n, tab) in rows.iter().enumerate() {
+        let is_open = open == Some(tab.id.as_str());
+        let mut to = base.clone();
+        if !is_open {
+            to.push(("open", tab.id.clone()));
+        }
+        out.push_str(&format!(
+            "<div class=\"r tab{}\" data-i=\"{}\" data-id=\"{}\"><a href=\"{}\">{} {}</a><span>{}</span><span>{}</span><span>{}</span></div>\n",
+            if is_open { " open" } else { "" },
+            offset + n,
+            esc(&tab.id),
+            esc(&web.link("table", &to)),
+            if is_open { "▾" } else { "▸" },
+            esc(&tab.name),
+            esc(&tab.r#type),
+            esc(&store_cmd::items_cell(tab.fetched_at, tab.item_count)),
+            esc(&store_cmd::ago(now, tab.fetched_at)),
+        ));
+    }
+    timing.took("render", began);
+    fragment(out, &timing)
+}
+
+/// A run's result, kept: one JSON line appended to the file
+/// `ACQ_RIG_RESULTS` names, so a sitting costs its sitter nothing but
+/// opening the links.
+pub(super) async fn result(headers: HeaderMap, body: String) -> Response {
+    let Some(path) = std::env::var_os("ACQ_RIG_RESULTS") else {
+        return refused(StatusCode::NOT_FOUND, "this server keeps no results");
+    };
+    let Ok(sent) = serde_json::from_str::<Value>(&body) else {
+        return refused(StatusCode::BAD_REQUEST, "a result is the measure's JSON");
+    };
+    let line = json!({
+        "at": acquisition_store::now(),
+        "case": sent["case"],
+        "user_agent": headers
+            .get(header::USER_AGENT)
+            .and_then(|v| v.to_str().ok()),
+        "window": sent["window"],
+        "result": sent["result"],
+    });
+    use std::io::Write as _;
+    let kept = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(&path)
+        .and_then(|mut file| writeln!(file, "{line}"));
+    match kept {
+        Ok(()) => (StatusCode::OK, "kept").into_response(),
+        Err(e) => refused(StatusCode::INTERNAL_SERVER_ERROR, &e.to_string()),
+    }
+}
+
+pub(super) async fn window_script() -> Response {
+    (
+        [(header::CONTENT_TYPE, "text/javascript; charset=utf-8")],
+        WINDOW,
+    )
+        .into_response()
+}
+
+pub(super) async fn measure_script() -> Response {
+    (
+        [(header::CONTENT_TYPE, "text/javascript; charset=utf-8")],
+        MEASURE,
+    )
+        .into_response()
+}
diff --git a/rig-probes.py b/rig-probes.py
new file mode 100644
index 00000000..81baba0b
--- /dev/null
+++ b/rig-probes.py
@@ -0,0 +1,160 @@
+"""The window rig's fault checks (step 6.3's spike, never committed as
+code; its record is `audits/web-2026-11/spike/README.md`): each fault
+its reviews found, made on purpose, and what the measure and the runner
+must make of it.
+
+    python3 -I -B rig-probes.py                                  # the deadlines
+    python3 -I -B rig-probes.py <acq web URL> <profile dir>      # and the page
+
+Exits 1 when a check does not hold. The deadlines need no browser: a
+fake debugging socket and a fake page list answer a byte every 3 s, so
+each read stays inside any per-read limit, and the call must still end
+at its deadline. The page checks run the flat case headless with a
+fault injected before the measure starts: rows that declare indices
+outside the slots in view (relabel) and a block drawn 24 px from its
+layout place (transform) must void the run; the first block held
+unanswered past the run (stall) must be in the result, pending.
+"""
+
+import importlib.util
+import json
+import os
+import socket
+import subprocess
+import sys
+import threading
+import time
+
+spec = importlib.util.spec_from_file_location("rig", os.path.join(os.path.dirname(__file__), "rig-run.py"))
+rig = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(rig)
+
+DEADLINE = 5.0
+failures = []
+
+
+def check(name, held, said):
+    print(f"{'ok  ' if held else 'FAIL'} {name}: {said}", flush=True)
+    if not held:
+        failures.append(name)
+
+
+def dribbling_server(reply_head, body):
+    """A server that answers one request with `reply_head`, then `body`
+    a byte every 3 s; its port."""
+    server = socket.socket()
+    server.bind(("127.0.0.1", 0))
+    server.listen(1)
+
+    def serve():
+        c, _ = server.accept()
+        head = b""
+        while b"\r\n\r\n" not in head:
+            head += c.recv(1)
+        c.sendall(reply_head)
+        if b"websocket" in reply_head.lower():
+            c.recv(4096)  # the client's call
+        for b in body:
+            time.sleep(3)
+            try:
+                c.sendall(bytes([b]))
+            except OSError:
+                return  # the client gave up: what the check waits for
+
+    threading.Thread(target=serve, daemon=True).start()
+    return server.getsockname()[1]
+
+
+def ends_by_deadline(name, work):
+    out = {}
+
+    def run():
+        began = time.monotonic()
+        try:
+            work()
+            out["said"] = ("answered", 0)
+        except OSError as e:
+            out["said"] = (type(e).__name__, time.monotonic() - began)
+
+    t = threading.Thread(target=run, daemon=True)
+    t.start()
+    t.join(DEADLINE + 10)
+    said = out.get("said")
+    held = said is not None and said[0] == "TimeoutError" and said[1] <= DEADLINE + 1
+    check(name, held, f"raised {said[0]} after {said[1]:.1f} s" if said else "still waiting")
+
+
+def deadlines():
+    rig.ANSWER = DEADLINE
+    body = b'{"id": 1, "result": {}}' + b" " * 77
+    port = dribbling_server(
+        b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n"
+        + bytes([0x81, len(body)]),
+        body,
+    )
+    ws = rig.Socket(f"ws://127.0.0.1:{port}/devtools/page/x")
+    ends_by_deadline("a debugging call answered a byte at a time ends at its deadline", lambda: ws.call("Runtime.evaluate", expression="1"))
+    listing = b'[{"type": "page", "webSocketDebuggerUrl": "ws://x"}]' + b" " * 50
+    port = dribbling_server(b"HTTP/1.1 200 OK\r\nContent-Length: %d\r\n\r\n" % len(listing), listing)
+    ends_by_deadline(
+        "the page list answered a byte at a time ends at its deadline",
+        lambda: rig.page_list(port, time.monotonic() + DEADLINE),
+    )
+
+
+def page(url, profile, fault):
+    """The flat case, headless, with `fault` made before the measure
+    starts; the measure's result."""
+    chrome = subprocess.Popen(
+        [rig.CHROME, "--headless=new", f"--user-data-dir={profile}", "--remote-debugging-port=0",
+         "--window-size=1440,900", "--force-device-scale-factor=2", "--no-first-run", "about:blank"],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+    )
+    try:
+        port_file = os.path.join(profile, "DevToolsActivePort")
+        if os.path.exists(port_file):
+            os.remove(port_file)
+        ws = rig.find_page(profile, time.monotonic() + 60)
+        if fault == "stall":
+            # the first block, held unanswered whenever asked: never continued
+            ws.call("Fetch.enable", patterns=[{"urlPattern": "*offset=0&count=50*", "requestStage": "Request"}])
+        ws.call("Page.navigate", url=url + "table?realm=pc&text=&measure=1")
+        time.sleep(0.6)  # loaded, the first block in, the measure not yet started (1 s after load)
+        make = {
+            "relabel": """(() => { document.querySelectorAll('.seg .block')[0].querySelectorAll('.r')
+                .forEach((r, j) => { r.dataset.i = String(5000 + j); }); })()""",
+            "transform": """(() => { document.querySelectorAll('.seg .block')[0]
+                .style.transform = 'translateY(24px)'; })()""",
+            "stall": "0",
+        }[fault]
+        ws.call("Runtime.evaluate", expression=make)
+        ends = time.monotonic() + rig.RUN
+        while time.monotonic() < ends:
+            time.sleep(1)
+            got = ws.call("Runtime.evaluate", until=ends, returnByValue=True,
+                          expression="window.rigResult ? JSON.stringify(window.rigResult) : ''")
+            if got["result"].get("value"):
+                return json.loads(got["result"]["value"])
+        return None
+    finally:
+        chrome.terminate()
+        chrome.wait(timeout=10)
+
+
+def pages(url, profile):
+    for fault in ("relabel", "transform"):
+        r = page(url, profile, fault)
+        check(f"rows drawn off their place ({fault}) void the run", bool(r and r["voided"] and r["off"]["frames"] > 0),
+              f"voided {r and r['voided']}, {r and r['off']['frames']} frames off")
+    r = page(url, profile, "stall")
+    held = [e for e in (r or {}).get("windows", {}).get("each", []) if e["offset"] == 0]
+    check("a window unanswered at the run's end is in the result, pending", any(e["state"] == "pending" for e in held),
+          f"the held block's records: {[e['state'] for e in held] or 'none'}")
+
+
+if __name__ == "__main__":
+    deadlines()
+    if len(sys.argv) > 2:
+        pages(sys.argv[1], sys.argv[2])
+    sys.exit(1 if failures else 0)
