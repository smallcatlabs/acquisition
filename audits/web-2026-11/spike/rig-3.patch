+"""The window rig's headless runs (step 6.3's spike, never committed as
+code; its record is `audits/web-2026-11/spike/README.md`).
+
+    python3 -I rig-run.py <acq web URL> <profile dir> <runs> <out.jsonl> [case,…]
+
+Starts headless Chrome on the profile directory given (never a person's
+own), at a 1440 x 900 viewport and a device pixel ratio of 2, loads each
+case's page with `measure` in its URL, waits for the measure's result
+(`window.rigResult`) and appends it, one JSON line per run. Talks to
+Chrome over its debugging protocol with the standard library alone.
+Every call has an absolute deadline, `ANSWER` seconds or the run's end
+(`RUN` seconds from its navigation), whichever comes first, and each
+read waits only what is left of it; so does finding the browser's page,
+its port file and its page list: a browser that stops answering, or
+answers a byte at a time, is a run recorded as failed, and the runner
+stops there. `rig-probes.py` beside it checks the deadlines and the
+measure's judgments by fault.
+"""
+
+import base64
+import json
+import os
+import socket
+import struct
+import subprocess
+import sys
+import time
+import urllib.request
+
+CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
+ANSWER = 30  # seconds a debugging call may wait for its answer
+RUN = 180  # seconds a run may take
+CASES = {
+    "F": "table?realm=pc&text=",
+    "F1k": "table?realm=pc&text=" + urllib.request.quote('category="accessory.ring" ilvl>=1'),
+    "G0": "table?realm=pc&text=&group=tabs&league=Standard",
+    "G1": "table?realm=pc&text=&group=tabs&league=Standard&open=d8132eff92",
+}
+
+
+def wait(deadline, what):
+    """Raise once the deadline has passed; else what is left of it."""
+    left = deadline - time.monotonic()
+    if left <= 0:
+        raise TimeoutError(f"{what}: the deadline passed")
+    return left
+
+
+def page_list(port, deadline):
+    """The browser's page list, `GET /json/list`, by its deadline: the
+    connection and each read wait only what is left of it."""
+    s = socket.create_connection(("127.0.0.1", int(port)), timeout=wait(deadline, "page list"))
+    try:
+        s.settimeout(wait(deadline, "page list"))
+        s.sendall(f"GET /json/list HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nConnection: close\r\n\r\n".encode())
+        data = b""
+        while True:
+            s.settimeout(wait(deadline, "page list"))
+            chunk = s.recv(65536)
+            if not chunk:
+                break
+            data += chunk
+            head, _, body = data.partition(b"\r\n\r\n")
+            length = [int(line.split(b":")[1]) for line in head.split(b"\r\n") if line.lower().startswith(b"content-length:")]
+            if length and len(body) >= length[0]:
+                break
+        return json.loads(data.partition(b"\r\n\r\n")[2])
+    finally:
+        s.close()
+
+
+def find_page(profile, deadline):
+    """The debugging socket of the browser's page, by the deadline."""
+    port_file = os.path.join(profile, "DevToolsActivePort")
+    while not (os.path.exists(port_file) and open(port_file).read().strip()):
+        wait(deadline, "the browser's port file")
+        time.sleep(0.1)
+    port = open(port_file).read().split()[0]
+    page = next(t for t in page_list(port, deadline) if t["type"] == "page")
+    return Socket(page["webSocketDebuggerUrl"])
+
+
+class Socket:
+    """One websocket to a debugging target: text frames, masked out."""
+
+    def _until(self, deadline):
+        """Let the socket's next operation wait only what is left."""
+        self.s.settimeout(wait(deadline, "the debugging call"))
+
+    def __init__(self, url):
+        rest = url.split("://", 1)[1]
+        hostport, path = rest.split("/", 1)
+        host, port = hostport.split(":")
+        self.s = socket.create_connection((host, int(port)), timeout=ANSWER)
+        key = base64.b64encode(os.urandom(16)).decode()
+        self.s.sendall(
+            (
+                f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\nUpgrade: websocket\r\n"
+                f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
+                "Sec-WebSocket-Version: 13\r\n\r\n"
+            ).encode()
+        )
+        deadline = time.monotonic() + ANSWER
+        head = b""
+        while b"\r\n\r\n" not in head:
+            self._until(deadline)
+            head += self.s.recv(1)
+        if b" 101 " not in head.split(b"\r\n")[0]:
+            raise RuntimeError(head.decode(errors="replace"))
+        self.next = 0
+
+    def _exact(self, n, deadline):
+        out = b""
+        while len(out) < n:
+            self._until(deadline)
+            chunk = self.s.recv(n - len(out))
+            if not chunk:
+                raise RuntimeError("the target closed its socket")
+            out += chunk
+        return out
+
+    def send(self, obj, deadline):
+        data = json.dumps(obj).encode()
+        mask = os.urandom(4)
+        n = len(data)
+        if n < 126:
+            head = struct.pack("!BB", 0x81, 0x80 | n)
+        elif n < 65536:
+            head = struct.pack("!BBH", 0x81, 0x80 | 126, n)
+        else:
+            head = struct.pack("!BBQ", 0x81, 0x80 | 127, n)
+        body = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
+        self._until(deadline)
+        self.s.sendall(head + mask + body)
+
+    def receive(self, deadline):
+        message = b""
+        while True:
+            b0, b1 = self._exact(2, deadline)
+            n = b1 & 0x7F
+            if n == 126:
+                (n,) = struct.unpack("!H", self._exact(2, deadline))
+            elif n == 127:
+                (n,) = struct.unpack("!Q", self._exact(8, deadline))
+            payload = self._exact(n, deadline)
+            if b0 & 0x0F in (0x9, 0xA):
+                continue
+            message += payload
+            if b0 & 0x80:
+                return json.loads(message)
+
+    def call(self, method, until=None, **params):
+        """One call, answered by its deadline: `ANSWER` seconds from now,
+        or `until` where that comes first."""
+        deadline = time.monotonic() + ANSWER
+        if until is not None:
+            deadline = min(deadline, until)
+        self.next += 1
+        mine = self.next
+        self.send({"id": mine, "method": method, "params": params}, deadline)
+        while True:
+            reply = self.receive(deadline)
+            if reply.get("id") == mine:
+                if "error" in reply:
+                    raise RuntimeError(reply["error"])
+                return reply.get("result", {})
+
+
+def main():
+    url, profile, runs, out = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
+    wanted = sys.argv[5].split(",") if len(sys.argv) > 5 else list(CASES)
+    # a port file left by an earlier browser on this profile names a port
+    # nobody listens on now
+    stale = os.path.join(profile, "DevToolsActivePort")
+    if os.path.exists(stale):
+        os.remove(stale)
+    chrome = subprocess.Popen(
+        [
+            CHROME,
+            "--headless=new",
+            f"--user-data-dir={profile}",
+            "--remote-debugging-port=0",
+            "--window-size=1440,900",
+            "--force-device-scale-factor=2",
+            "--no-first-run",
+            "--no-default-browser-check",
+            "about:blank",
+        ],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+    )
+    try:
+        try:
+            ws = find_page(profile, time.monotonic() + 2 * ANSWER)
+            version = ws.call("Runtime.evaluate", expression="navigator.userAgent", returnByValue=True)
+        except (OSError, RuntimeError, StopIteration) as e:
+            # no page found by the deadline: the first run fails, and the
+            # runner stops there
+            with open(out, "a") as sink:
+                line = {"case": wanted[0], "run": 1, "result": None, "failed": f"the browser's page was not found: {e}"}
+                sink.write(json.dumps(line) + "\n")
+            print(f"{wanted[0]} run 1: FAILED, {line['failed']}", flush=True)
+            return
+        print("browser:", version["result"]["value"], flush=True)
+        with open(out, "a") as sink:
+            for run in range(1, runs + 1):
+                for case in wanted:
+                    path = CASES[case]
+                    result = None
+                    failed = None
+                    try:
+                        ends = time.monotonic() + RUN
+                        ws.call("Page.navigate", until=ends, url=url + path + "&measure=1&case=" + case)
+                        while time.monotonic() < ends - 1:
+                            time.sleep(1)
+                            got = ws.call(
+                                "Runtime.evaluate",
+                                until=ends,
+                                expression="window.rigResult ? JSON.stringify(window.rigResult) : ''",
+                                returnByValue=True,
+                            )
+                            if got["result"].get("value"):
+                                result = json.loads(got["result"]["value"])
+                                break
+                        else:
+                            failed = f"no result in {RUN} s"
+                    except (OSError, RuntimeError) as e:
+                        failed = f"the browser stopped answering: {e}"
+                    line = {"case": case, "run": run, "result": result, "failed": failed}
+                    sink.write(json.dumps(line) + "\n")
+                    sink.flush()
+                    if failed:
+                        print(f"{case} run {run}: FAILED, {failed}", flush=True)
+                        if result is None and "stopped" in failed:
+                            return
+                        continue
+                    jumps = sorted(j["ms"] if j["ms"] is not None else float("inf") for j in result["jumps"])
+                    print(
+                        f"{case} run {run}: {'PASSED' if result['passed'] else 'MISSED'}"
+                        f"{' VOID' if result['voided'] else ''} · {result['rate']} Hz · steady "
+                        f"{result['steady']['late']}/{result['steady']['frames']} late, "
+                        f"{result['steady']['missing']} missing, longest {result['steady']['longest']:.1f} ms"
+                        f" · jumps ms {[round(j) if j != float('inf') else None for j in jumps]}"
+                        f" · DOM {result['dom']['elements']} elements, {result['dom']['rows']} rows"
+                        f" · checked {result['off']['checked']}, wrong {result['off']['wrong']}",
+                        flush=True,
+                    )
+    finally:
+        chrome.terminate()
+        chrome.wait(timeout=10)
+
+
+if __name__ == "__main__":
+    main()
