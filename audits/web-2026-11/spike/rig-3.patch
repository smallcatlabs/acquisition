diff --git a/crates/acquisition-cli/src/web/assets/measure.js b/crates/acquisition-cli/src/web/assets/measure.js
new file mode 100644
index 00000000..bcefa678
--- /dev/null
+++ b/crates/acquisition-cli/src/web/assets/measure.js
@@ -0,0 +1,364 @@
+// The rig's measure (step 6.3's spike), loaded only with `measure` in
+// the page's URL and never part of the window: it drives the page's
+// scroll in each animation frame, looks at what that frame shows, and
+// judges the run by the bar in `audits/web-2026-11/spike/README.md`.
+//
+// A run: 90 still frames (the display's interval, their median); a
+// move to the steady scroll's start, held until its viewport is whole;
+// the steady scroll, SPEED px/s for STEADY ms; then the jumps, each held
+// until its viewport is whole (or TIMEOUT) and HOLD ms more; then each
+// row seen is checked against the window's JSON at the same basis.
+(function () {
+  const table = document.querySelector('.rig[data-h]');
+  if (!table) return;
+  const h = Number(table.dataset.h);
+  const SPEED = 1500;
+  const STEADY = 10000;
+  const STILL = 90;
+  const HOLD = 500;
+  const TIMEOUT = 3000;
+  const SETTLE = 1000;
+  const segs = Array.from(table.querySelectorAll('.seg'), (el) => ({
+    el,
+    count: Number(el.dataset.count),
+    base: Number(el.dataset.base),
+    route: el.dataset.route,
+  }));
+  const scroller = document.scrollingElement;
+  const vh = () => window.innerHeight;
+  const maxY = () => scroller.scrollHeight - vh();
+  const docTop = (s) => s.el.getBoundingClientRect().top + window.scrollY;
+
+  // what this frame shows: each segment's slots in the viewport, filled
+  // by the row of that index at its place, or missing. Every row drawn
+  // in the viewport is judged by where it is drawn (its rendered box,
+  // whatever its layout or its declared index say, in any segment): one
+  // away from its index's place is off.
+  const seen = new Map();
+  let changed = 0;
+  let lookMs = 0;
+  const look = () => {
+    const began = performance.now();
+    let missing = 0;
+    let off = 0;
+    const height = vh();
+    segs.forEach((s, n) => {
+      const top = s.el.getBoundingClientRect().top;
+      const lo = Math.max(0, Math.floor(-top / h));
+      const hi = Math.min(s.count, Math.ceil((height - top) / h));
+      const filled = new Set();
+      for (const row of s.el.querySelectorAll('.r')) {
+        const box = row.getBoundingClientRect();
+        if (box.bottom <= 0 || box.top >= height) continue;
+        const at = box.top - top;
+        const i = Number(row.dataset.i) - s.base;
+        if (Math.abs(at - i * h) > 0.5) {
+          off++;
+          continue;
+        }
+        if (i < lo || i >= hi) continue;
+        filled.add(i);
+        const key = n + ':' + i;
+        const was = seen.get(key);
+        if (was === undefined) seen.set(key, row.dataset.id);
+        else if (was !== row.dataset.id) changed++;
+      }
+      missing += Math.max(0, hi - lo) - filled.size;
+    });
+    lookMs += performance.now() - began;
+    return { missing, off };
+  };
+
+  let maxDom = 0;
+  let maxRows = 0;
+  const sampleDom = () => {
+    maxDom = Math.max(maxDom, document.getElementsByTagName('*').length);
+    maxRows = Math.max(maxRows, table.querySelectorAll('.seg .r').length);
+  };
+
+  // the jumps: fractions of the page in one segment; in a page with an
+  // opened block, its start, middle and end, both its edges half in
+  // view, and the page's middle, end and start
+  const jumps = () => {
+    const m = maxY();
+    const clamp = (y) => Math.round(Math.max(0, Math.min(m, y)));
+    if (segs.length < 3) {
+      return [0.5, 0.1, 0.9, 0.25, 1, 0.75, 0.37, 0.61, 0.83, 0].map((f) => ({
+        name: 'page ' + f,
+        y: clamp(f * m),
+      }));
+    }
+    const top = docTop(segs[1]);
+    const bottom = top + segs[1].count * h;
+    const v = vh();
+    return [
+      ['block start', top],
+      ['block middle', (top + bottom) / 2 - v / 2],
+      ['block end', bottom - v],
+      ['block top edge', top - v / 2],
+      ['block bottom edge', bottom - v / 2],
+      ['page 0.5', 0.5 * m],
+      ['page 1', m],
+      ['page 0', 0],
+      ['block quarter', top + (bottom - top) / 4],
+      ['block three quarters', top + (3 * (bottom - top)) / 4],
+    ].map(([name, y]) => ({ name, y: clamp(y) }));
+  };
+  const steadyFrom = () =>
+    segs.length < 3 ? 0 : Math.max(0, Math.round(docTop(segs[1]) - 1.5 * vh()));
+
+  const frames = [];
+  const still = [];
+  const jumped = [];
+  let last = null;
+  let phase = 'still';
+  let since = 0;
+  let from = 0;
+  let plan = [];
+  let at = 0;
+  let jump = null;
+
+  const step = (t) => {
+    const dt = last === null ? null : t - last;
+    last = t;
+    if (phase === 'still') {
+      if (dt !== null) still.push(dt);
+      if (still.length >= STILL) {
+        phase = 'start';
+        since = t;
+        from = steadyFrom();
+        window.scrollTo(0, from);
+      }
+    } else if (phase === 'start') {
+      // the steady scroll starts from a whole viewport
+      if ((look().missing === 0 && t - since >= HOLD) || t - since >= TIMEOUT) {
+        phase = 'steady';
+        since = t;
+      }
+    } else if (phase === 'steady') {
+      const y = from + (SPEED * (t - since)) / 1000;
+      if (t - since >= STEADY || y >= maxY()) {
+        phase = 'jumps';
+        plan = jumps();
+        at = 0;
+        jump = null;
+      } else {
+        window.scrollTo(0, y);
+      }
+    }
+    if (phase === 'jumps' && jump === null) {
+      if (at >= plan.length) {
+        phase = 'done';
+        finish();
+        return;
+      }
+      jump = { ...plan[at], t0: t, ms: null };
+      window.scrollTo(0, jump.y);
+    }
+    const shown = look();
+    if (frames.length % 30 === 0) sampleDom();
+    frames.push({ phase, dt, missing: shown.missing, off: shown.off });
+    if (phase === 'jumps') {
+      if (jump.ms === null && shown.missing === 0) {
+        jump.ms = t - jump.t0;
+        jump.whole = t;
+        sampleDom();
+      }
+      const timedOut = jump.ms === null && t - jump.t0 >= TIMEOUT;
+      if (timedOut || (jump.ms !== null && t - jump.whole >= HOLD)) {
+        jumped.push({ name: jump.name, y: jump.y, at: Math.round(jump.t0), ms: jump.ms });
+        jump = null;
+        at++;
+      }
+    }
+    requestAnimationFrame(step);
+  };
+
+  // every row seen, against the window's JSON at the same basis, asked
+  // in chunks of another size than the script's blocks
+  const truth = async () => {
+    const CHUNK = 128;
+    let checked = 0;
+    let wrong = 0;
+    for (let n = 0; n < segs.length; n++) {
+      const s = segs[n];
+      const chunks = new Set();
+      for (const key of seen.keys()) {
+        const [k, i] = key.split(':').map(Number);
+        if (k === n) chunks.add(Math.floor(i / CHUNK));
+      }
+      for (const c of chunks) {
+        const res = await pass(s.route + '&offset=' + (s.base + c * CHUNK) + '&count=' + CHUNK, {
+          headers: { Accept: 'application/json' },
+        });
+        const doc = await res.json();
+        doc.ids.forEach((id, j) => {
+          const key = n + ':' + (c * CHUNK + j);
+          if (!seen.has(key)) return;
+          checked++;
+          if (seen.get(key) !== id) wrong++;
+        });
+      }
+    }
+    return { checked, wrong };
+  };
+
+  const median = (xs) => {
+    const s = [...xs].sort((a, b) => a - b);
+    return s.length ? s[Math.floor(s.length / 2)] : null;
+  };
+
+  // every window the page asks from the measure's start, recorded as it
+  // is asked: the measure wraps the page's fetch, which the window
+  // script calls by name, and passes each call through unchanged. Each
+  // keeps its route, offset and count, when it was asked, its state
+  // (pending, done, aborted or failed), its time to its body's end and
+  // each step of the server's part (the routes' Server-Timing).
+  const asked = [];
+  const pass = window.fetch.bind(window);
+  window.fetch = (input, init) => {
+    const url = new URL(String(input), location.href);
+    const route = url.pathname.split('/').pop();
+    if (route !== 'window' && route !== 'heads') return pass(input, init);
+    const entry = {
+      route: route,
+      offset: Number(url.searchParams.get('offset')),
+      count: Number(url.searchParams.get('count')),
+      at: Math.round(performance.now()),
+      state: 'pending',
+    };
+    asked.push(entry);
+    const ended = (e) => (e && e.name === 'AbortError' ? 'aborted' : 'failed');
+    return pass(input, init).then(
+      (res) => {
+        entry.status = res.status;
+        entry.server = Object.fromEntries(
+          (res.headers.get('server-timing') || '')
+            .split(',')
+            .filter((t) => t.includes('dur='))
+            .map((t) => [t.split(';')[0].trim(), Number(t.split('dur=')[1])]),
+        );
+        res
+          .clone()
+          .text()
+          .then(
+            () => {
+              entry.ms = Math.round((performance.now() - entry.at) * 10) / 10;
+              entry.state = 'done';
+            },
+            (e) => {
+              entry.state = ended(e);
+            },
+          );
+        return res;
+      },
+      (e) => {
+        entry.state = ended(e);
+        throw e;
+      },
+    );
+  };
+  const windows = () => {
+    const done = asked.filter((e) => e.state === 'done');
+    const spread = (xs) => {
+      const s = [...xs].sort((a, b) => a - b);
+      const at = (q) => (s.length ? s[Math.min(s.length - 1, Math.ceil(q * s.length) - 1)] : null);
+      return { median: at(0.5), p95: at(0.95), max: at(1) };
+    };
+    const states = {};
+    for (const e of asked) states[e.state] = (states[e.state] || 0) + 1;
+    return {
+      each: asked.map((e) => ({ ...e })),
+      asked: asked.length,
+      states: states,
+      ms: spread(done.map((e) => e.ms)),
+      serverMs: spread(done.map((e) => Object.values(e.server).reduce((sum, d) => sum + d, 0))),
+      answerMs: spread(done.map((e) => (e.server.answer || 0) + (e.server.listing || 0))),
+    };
+  };
+
+  const finish = async () => {
+    const record = windows();
+    const interval = median(still);
+    const late = interval * 1.5;
+    const steady = frames.filter((f) => f.phase === 'steady' && f.dt !== null);
+    const inJumps = frames.filter((f) => f.phase === 'jumps' && f.dt !== null);
+    const lateSteady = steady.filter((f) => f.dt > late).length;
+    const missingSteady = steady.filter((f) => f.missing > 0).length;
+    const offFrames = frames.filter((f) => f.off > 0).length;
+    const longestJumpFrame = Math.max(0, ...inJumps.map((f) => f.dt));
+    const longestSteadyFrame = Math.max(0, ...steady.map((f) => f.dt));
+    const ms = jumped.map((j) => (j.ms === null ? Infinity : j.ms));
+    const sorted = [...ms].sort((a, b) => a - b);
+    const checked = await truth();
+    const pct = (n, d) => (d ? (100 * n) / d : 0);
+    const bar = {
+      'steady: at most 1% of frames late': pct(lateSteady, steady.length) <= 1,
+      'jumps: no frame longer than 100 ms': longestJumpFrame <= 100,
+      'jumps: 9 of 10 whole within 100 ms': sorted.length >= 10 && sorted[8] <= 100,
+      'jumps: every one whole within 250 ms': sorted.length > 0 && sorted[sorted.length - 1] <= 250,
+      'steady: at most 1% of frames with a row missing': pct(missingSteady, steady.length) <= 1,
+      'live DOM: at most 5,000 elements and 250 rows': maxDom <= 5000 && maxRows <= 250,
+    };
+    const voided = offFrames > 0 || changed > 0 || checked.wrong > 0;
+    const result = {
+      url: location.pathname.replace(/^\/[^/]+/, '') + location.search,
+      viewport: [window.innerWidth, window.innerHeight, window.devicePixelRatio],
+      rows: segs.map((s) => s.count),
+      interval: interval,
+      rate: interval ? Math.round(1000 / interval) : null,
+      steady: {
+        speed: SPEED,
+        from: from,
+        frames: steady.length,
+        late: lateSteady,
+        longest: longestSteadyFrame,
+        missing: missingSteady,
+      },
+      jumps: jumped,
+      jumpFrames: { frames: inJumps.length, late: inJumps.filter((f) => f.dt > late).length, longest: longestJumpFrame },
+      dom: { elements: maxDom, rows: maxRows },
+      windows: record,
+      off: { frames: offFrames, changed: changed, checked: checked.checked, wrong: checked.wrong },
+      lookMsPerFrame: frames.length ? lookMs / frames.length : 0,
+      bar: bar,
+      voided: voided,
+      passed: !voided && Object.values(bar).every(Boolean),
+    };
+    const pre = document.createElement('pre');
+    pre.className = 'rig-result';
+    pre.textContent =
+      (result.voided ? 'VOID: a row off its place or not the answer\'s\n' : '') +
+      (result.passed ? 'PASSED' : 'MISSED') +
+      '\n' +
+      JSON.stringify(result, null, 1);
+    table.before(pre);
+    window.scrollTo(0, 0);
+    // the result kept by the server too (rig-3), with the case the link
+    // names and the window as the page measures it
+    const sent = await pass('result', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        case: new URLSearchParams(location.search).get('case'),
+        window: {
+          inner: [window.innerWidth, window.innerHeight],
+          outer: [window.outerWidth, window.outerHeight],
+          screen: [screen.width, screen.height],
+          ratio: window.devicePixelRatio,
+        },
+        result: result,
+      }),
+    }).then(
+      (res) => (res.ok ? 'kept by the server' : 'not kept: ' + res.status),
+      (e) => 'not kept: ' + e,
+    );
+    pre.textContent = sent + '\n' + pre.textContent;
+    result.sent = sent;
+    window.rigResult = result;
+  };
+
+  window.addEventListener('load', () => {
+    setTimeout(() => requestAnimationFrame(step), SETTLE);
+  });
+})();
